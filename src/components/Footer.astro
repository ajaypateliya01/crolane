---
import { SERVICES } from '../config/services';
import { SITE } from '../config/site';
import site from '../content/settings/site.json';
import { offerLive } from '../lib/offer';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 12 6 7l3 3 5-7" fill="none" stroke="#140d26" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>CROLANE</a>
        <p style="max-width:22rem;font-size:.95rem">Developer-led CRO, analytics and AI automation for Shopify and ecommerce brands. Run by {site.founder.name}.</p>
        <p style="margin-top:14px;font-size:.95rem"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div><p class="fh">CRO and testing</p><ul>{SERVICES.slice(0, 3).map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul></div>
      <div><p class="fh">Analytics and AI</p><ul>{SERVICES.slice(3).map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul></div>
      <div><p class="fh">Company</p><ul>
        <li><a href="/services/">All services</a></li><li><a href="/pricing/">Pricing</a></li><li><a href="/about/">About</a></li><li><a href="/blog/">Blog</a></li><li><a href="/contact/">Contact</a></li>
        {offerLive && <li><a href="/bfcm/">Black Friday offer</a></li>}
        <li><a href={site.founder.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul></div>
    </div>
    <div class="legal"><span>&copy; {year} CROLANE. All rights reserved.</span><span><a href="/privacy/">Privacy</a> &nbsp; <a href="/terms/">Terms</a></span></div>
  </div>
</footer>
