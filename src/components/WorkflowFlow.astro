---
/**
 * Practical AI workflow: a labelled, reviewable pipeline with a runnable
 * illustrative example. The demo routes one sample enquiry through
 * classification, extraction, a decision and a human checkpoint.
 */
type Node = {
  id: string;
  num: string;
  title: string;
  desc: string;
  detail: string;
  payload: string;
  branch?: boolean;
};

const nodes: Node[] = [
  {
    id: 'n1',
    num: '01',
    title: 'Intake',
    desc: 'A web form submission arrives.',
    detail:
      'The trigger is an ordinary event: a customer fills in your enquiry form. Nothing exotic, just the start of the process.',
    payload: 'channel: website form\nname: Rohan S.\nmessage: "Need a quote for a 40 page site"',
  },
  {
    id: 'n2',
    num: '02',
    title: 'Classify',
    desc: 'AI reads and tags the enquiry.',
    detail:
      'A language model sorts the message into categories you define (pricing, support, partnership) with a confidence score. Wrong tags are catchable.',
    payload: 'category: pricing enquiry\nconfidence: 0.91\nlanguage: en',
  },
  {
    id: 'n3',
    num: '03',
    title: 'Extract',
    desc: 'Key fields are pulled into structure.',
    detail:
      'Names, timelines, budgets and needs are extracted into clean fields your team (or another system) can use without re-reading every message.',
    payload: 'name: Rohan S.\ntimeline: 4 weeks\nbudget: not provided',
  },
  {
    id: 'n4',
    num: '04',
    title: 'Decision',
    desc: 'Is there enough detail to act on?',
    detail:
      'A plain rule (not an AI guess) decides the route. Missing budget means the next step is a short clarifying reply instead of a full quote.',
    payload: 'rule: budget provided?\nresult: no → route B',
    branch: true,
  },
  {
    id: 'n5b',
    num: '05',
    title: 'Clarifying reply',
    desc: 'An immediate, honest response goes out.',
    detail:
      'The visitor gets a prompt reply asking the two missing details, drafted from approved wording and ready for your team to review before sending.',
    payload:
      'draft: "Thanks Rohan. Before we quote: what budget band\n  are you working with, and do you have brand assets ready?"',
    branch: true,
  },
  {
    id: 'n6',
    num: '06',
    title: 'Human review',
    desc: 'A person approves the meaningful next step.',
    detail:
      'Anything that affects a customer commitment pauses for a person. AI handles the reading and drafting; the team keeps the decision.',
    payload: 'status: awaiting approval\nassignee: sales queue\nsla: today',
    branch: true,
  },
  {
    id: 'n7',
    num: '07',
    title: 'Logged & notified',
    desc: 'The outcome is recorded and visible.',
    detail:
      'The run finishes with a task logged and the team notified. Every step is inspectable, so the workflow stays understandable as it evolves.',
    payload: 'result: enquiry handled\nrecord: lead_1042\nnotified: 2 people',
  },
];
---

<section
  class="section workflow tone-lavender"
  aria-labelledby="workflow-title"
  data-workflow
  style="--accent: var(--color-emerald);"
>
  <div class="container-x">
    <header class="wf-head">
      <div>
        <p class="eyebrow eyebrow--accent" data-reveal="fade">AI systems & workflow automation</p>
        <h2 class="display-lg" id="workflow-title" data-reveal>
          Repetitive work, routed with <span class="display-italic">human checkpoints</span>.
        </h2>
      </div>
      <p class="lede" data-reveal data-reveal-delay="0.08">
        Practical automation is a chain of small, inspectable steps: read, classify, decide,
        act, review. Run the example to watch one enquiry move through.
      </p>
    </header>

    <div class="viz-stage wf-stage" data-reveal="scale">
      <div class="viz-chrome">
        <div class="viz-chrome-left">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="viz-url">workflow.demo / enquiry-router / run #1042</span>
        </div>
        <div class="wf-actions">
          <span class="viz-note">Illustrative workflow</span>
          <button class="btn btn-primary btn-sm" type="button" data-wf-run>Run the demo</button>
        </div>
      </div>

      <div class="wf-body">
        <!-- Flow rail -->
        <ol class="wf-flow" data-wf-flow>
          {
            nodes.map((n) => (
              <li
                class:list={['wf-node', { 'is-branch': n.branch, 'is-leaf': n.id === 'n5b' }]}
                data-node={n.id}
              >
                <button
                  type="button"
                  class="wf-card"
                  data-node-btn={n.id}
                  aria-pressed={n.id === 'n1' ? 'true' : 'false'}
                >
                  <span class="wf-num">{n.num}</span>
                  <span class="wf-node-copy">
                    <span class="wf-node-title">{n.title}</span>
                    <span class="wf-node-desc">{n.desc}</span>
                  </span>
                  <span class="status wf-status" data-node-status={n.id}>
                    idle
                  </span>
                </button>
              </li>
            ))
          }
        </ol>

        <!-- Detail panel -->
        <aside class="wf-detail" aria-live="polite">
          <p class="label-mono">Step detail</p>
          <h3 data-wf-title>Intake</h3>
          <p class="wf-detail-desc" data-wf-desc>A web form submission arrives.</p>
          <p class="wf-detail-body" data-wf-detail>
            The trigger is an ordinary event: a customer fills in your enquiry form. Nothing
            exotic, just the start of the process.
          </p>
          <p class="label-mono wf-payload-label" data-wf-payload-label>Sample payload</p>
          <div class="wf-payload" data-wf-payload aria-label="Sample payload">
            <pre>channel: website form
name: Rohan S.
message: "Need a quote for a 40 page site"</pre>
          </div>
          <div class="wf-summary" data-wf-summary hidden>
            <p class="label-mono">Run summary</p>
            <p>
              Enquiry classified, missing detail routed to a clarifying reply, human review
              requested. <strong>7 steps, 0 manual reads.</strong>
            </p>
          </div>
        </aside>
      </div>

      <script type="application/json" data-wf-data set:html={JSON.stringify(nodes)} />

      <p class="wf-disclaimer">
        This is an illustrative workflow, not a live automation on this site. Real
        implementations depend on your tools, data access and requirements, and always include
        appropriate review points for customer facing actions.
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/workflow';
</script>

<style>
  .workflow {
    background:
      radial-gradient(80% 55% at 8% 100%, rgb(23 131 91 / 0.07), transparent 60%),
      var(--color-paper-4);
    overflow: clip;
  }

  .wf-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .wf-head h2 {
    margin-top: 1.1rem;
    max-width: 17ch;
  }

  .wf-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .wf-body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  /* Flow ----------------------------------------------------------------- */
  .wf-flow {
    list-style: none;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .wf-node {
    position: relative;
    padding-left: 1.65rem;
    padding-bottom: 0.8rem;
  }

  .wf-node::before {
    content: '';
    position: absolute;
    left: 0.42rem;
    top: 1.35rem;
    bottom: -0.15rem;
    border-left: 2px dashed color-mix(in srgb, var(--color-ink) 20%, transparent);
    transition: border-color 0.4s var(--ease-out);
  }

  .wf-node:last-child::before {
    display: none;
  }

  .wf-node.flow-done::before,
  .wf-node.flow-run::before {
    border-left-style: solid;
    border-left-color: color-mix(in srgb, var(--color-emerald) 60%, transparent);
  }

  .wf-node::after {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    border: 2.5px solid color-mix(in srgb, var(--color-ink) 35%, transparent);
    transition: all 0.35s var(--ease-out);
  }

  .wf-node.flow-run::after {
    border-color: var(--color-azure);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-azure) 16%, transparent);
    animation: node-pulse 1.1s ease-in-out infinite;
  }

  .wf-node.flow-done::after {
    border-color: var(--color-emerald);
    background: var(--color-emerald);
  }

  @keyframes node-pulse {
    50% {
      box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-azure) 6%, transparent);
    }
  }

  .wf-node.is-branch {
    margin-left: clamp(1.25rem, 4vw, 2.75rem);
  }

  .wf-node.is-leaf::before {
    border-left-style: dotted;
  }

  .wf-card {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-align: left;
    padding: 0.8rem 0.95rem;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    background: #fff;
    cursor: pointer;
    box-shadow: 0 1px 2px rgb(22 22 27 / 0.04);
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .wf-card:hover {
    border-color: color-mix(in srgb, var(--color-emerald) 45%, transparent);
    transform: translateX(3px);
  }

  .wf-card[aria-pressed='true'] {
    border-color: var(--color-emerald);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-emerald) 14%, transparent);
  }

  .wf-num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-3);
    flex: none;
  }

  .wf-node-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .wf-node-title {
    font-size: 0.93rem;
    font-weight: 600;
  }

  .wf-node-desc {
    font-size: 0.76rem;
    color: var(--color-ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wf-status {
    flex: none;
    min-width: 3.4rem;
    justify-content: center;
  }

  /* Detail --------------------------------------------------------------- */
  .wf-detail {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 16px;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-self: start;
    position: sticky;
    top: 5.5rem;
    min-width: 0;
  }

  .wf-detail h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 400;
  }

  .wf-detail-desc {
    font-size: 0.92rem;
    color: var(--color-emerald);
    font-weight: 570;
  }

  .wf-detail-body {
    font-size: 0.89rem;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  .wf-payload-label {
    margin-bottom: -0.35rem;
  }

  .wf-payload {
    background: #15151a;
    border: 1.5px solid transparent;
    border-radius: 12px;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    transition: border-color 0.4s var(--ease-out);
  }

  .wf-payload.is-outcome {
    border-color: color-mix(in srgb, var(--color-emerald) 65%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-emerald) 12%, transparent);
  }

  .wf-payload pre {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.65;
    color: #b9e8d2;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .wf-summary {
    background: color-mix(in srgb, var(--color-emerald) 8%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-emerald) 30%, transparent);
    border-radius: 12px;
    padding: 0.85rem 0.95rem;
  }

  .wf-summary .label-mono {
    color: var(--color-emerald);
    margin-bottom: 0.3rem;
  }

  .wf-summary p:last-child {
    font-size: 0.85rem;
    color: var(--color-ink-2);
    line-height: 1.55;
  }

  .wf-disclaimer {
    padding: 0.95rem clamp(1rem, 2.5vw, 1.5rem) 1.2rem;
    font-size: 0.8rem;
    color: var(--color-ink-3);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: rgb(255 255 255 / 0.85);
  }

  /* Responsive */
  @media (max-width: 64rem) {
    .wf-body {
      grid-template-columns: 1fr;
    }

    .wf-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .wf-detail {
      position: static;
    }
  }

  @media (max-width: 34rem) {
    .wf-node-desc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-node.flow-run::after {
      animation: none;
    }
  }
</style>
