---
export type FaqItem = { q: string; a: string };

interface Props {
  items: FaqItem[];
  exclusive?: boolean;
  idPrefix?: string;
}
const { items, exclusive = true, idPrefix = 'faq' } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, i) => (
      <details class="faq-item" name={exclusive ? idPrefix : undefined}>
        <summary>
          <span>{item.q}</span>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <div class="faq-body">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
  }

  .faq-body p {
    animation: faq-in 0.4s var(--ease-out);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-body p {
      animation: none;
    }
  }
</style>
