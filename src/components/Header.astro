---
import { SERVICES, GROUPS, priceFor } from '../config/services';
import site from '../content/settings/site.json';
import { offerLive } from '../lib/offer';
import { UA } from './ui/Icons';

// The offer bar hides itself when it promotes BFCM and the offer is off.
const offer = site.offerBar;
const showOfferBar = offer.enabled && (offerLive || !offer.href.startsWith('/bfcm'));
const path = Astro.url.pathname;
const nav = [
  { label: 'Pricing', href: '/pricing/' },
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
const on = (href: string) => path.startsWith(href);
---
<header class="site" id="hdr">
  {showOfferBar && (
    <div class="offer"><span class="tag">Offer</span><span class="offer-text">{offer.text}</span> <a href={offer.href} data-track="offer_bar_click">{offer.linkLabel}</a></div>
  )}
  <div class="wrap nav">
    <a class="logo" href="/" aria-label="CROLANE home">
      <span class="logo-mark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 12 6 7l3 3 5-7" fill="none" stroke="#140d26" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>CROLANE
    </a>
    <nav aria-label="Main">
      <ul class="menu">
        <li class="dd" id="dd">
          <button type="button" aria-expanded="false" aria-controls="ddp" id="ddb" aria-current={on('/services') ? 'page' : undefined}>Services <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></button>
          <div class="dd-panel" id="ddp">
            {GROUPS.map((g) => (
              <div class="dd-group">
                <p class="dh">{g}</p>
                {SERVICES.filter((s) => s.grp === g).map((s) => (
                  <a href={s.path}><b>{s.name}</b><span>{priceFor(s.id) || s.kw}</span></a>
                ))}
              </div>
            ))}
          </div>
        </li>
        {nav.map((n) => <li><a href={n.href} aria-current={on(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-line" href="#mini-audit" data-track="header_audit">Free audit</a>
      <a class="btn btn-white" href="/contact/" data-track="header_contact">Talk to Ajay <Fragment set:html={UA} /></a>
      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></button>
    </div>
  </div>
  <div class="wrap mnav" id="mnav">
    {GROUPS.map((g) => (<><p class="dh">{g}</p>{SERVICES.filter((s) => s.grp === g).map((s) => <a href={s.path}>{s.name}</a>)}</>))}
    <p class="dh">Company</p>
    <a href="/services/">All services</a>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href="#mini-audit">Free audit</a>
  </div>
</header>
