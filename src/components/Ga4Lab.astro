---
import { serviceBySlug } from '../config/services';

const service = serviceBySlug('ga4-tag-manager')!;

const events = [
  { id: 'page_view', trigger: 'Fires on every page load', params: 'page_location, page_title' },
  { id: 'view_item', trigger: 'Product page becomes visible', params: 'item_id, item_name, price' },
  { id: 'add_to_cart', trigger: 'Shopper taps Add to bag', params: 'item_id, quantity, value' },
  { id: 'begin_checkout', trigger: 'Checkout starts', params: 'items, value, currency' },
  { id: 'purchase', trigger: 'Order confirmation shows', params: 'transaction_id, items, value' },
];
---

<div
  class="ga4-lab"
  data-ga4-lab
  style={`--accent:${service.accent}; --soft:${service.accentSoft};`}
>
  <header class="g-head">
    <div class="g-head-copy">
      <p class="eyebrow eyebrow--accent" data-reveal="fade">Interactive demo · Measurement Check Lab</p>
      <h2 class="display-md" data-reveal>Watch a GA4 setup prove itself</h2>
      <p class="g-lede" data-reveal data-reveal-delay="0.08">
        A measurement plan is only real when every event fires with the right name and the right
        details. Press Play and the demo walks the plan like a validation pass would.
      </p>
    </div>

    <aside class="g-preview" data-reveal="scale" data-reveal-delay="0.1" aria-label="Demo preview">
      <div class="g-preview-top">
        <span>Preview</span>
        <span class="g-ready"><i></i>Plan loaded</span>
      </div>
      <ul class="g-preview-list" aria-hidden="true">
        {events.map((e) => <li><span>{e.id}</span><em>waiting</em></li>)}
      </ul>
      <p>Five events on the checklist. Nothing has fired yet.</p>
    </aside>
  </header>

  <div class="g-shell" data-reveal="scale">
    <div class="g-controls">
      <p class="g-status">
        <span class="g-live-dot" aria-hidden="true"></span>
        <span data-ga4-status>Ready when you are. Press Play demo to run the validation.</span>
      </p>
      <button class="btn btn-primary g-play attn" type="button" data-ga4-play>
        <span class="g-play-icon" aria-hidden="true"></span>
        <span data-ga4-play-label>Play demo</span>
      </button>
    </div>

    <div class="g-grid">
      <div class="g-plan">
        <p class="g-kicker">Measurement plan · event checklist</p>
        <ul class="g-rows">
          {
            events.map((e) => (
              <li class="g-row" data-ga4-row={e.id} data-state="waiting">
                <span class="g-row-icon" aria-hidden="true"></span>
                <span class="g-row-main">
                  <b>{e.id}</b>
                  <small>{e.trigger}</small>
                  <small class="g-params">{e.params}</small>
                </span>
                <span class="g-chip" data-ga4-chip>Waiting</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="g-debug">
        <div class="g-debug-top">
          <span>DebugView · demo stream</span>
          <span class="g-debug-count"><b data-ga4-validated>0</b>/5 validated</span>
        </div>
        <ol class="g-log" data-ga4-log aria-live="polite">
          <li><span>setup</span>Measurement plan loaded. Waiting for the first event.</li>
        </ol>
        <div class="g-debug-foot">
          <div>
            <span>Issues found</span>
            <b data-ga4-issues>0</b>
          </div>
          <div>
            <span>Issues fixed</span>
            <b data-ga4-fixed>0</b>
          </div>
          <p class="g-verdict" data-ga4-verdict>No verdict yet. Run the demo to validate the plan.</p>
        </div>
      </div>
    </div>

    <p class="g-note">
      Illustrative demo with made-up events. Real validation checks your actual GA4 property,
      consent state and tag setup before anything is called correct.
    </p>
  </div>
</div>

<script>
  import '../scripts/ga4-lab';
</script>

<style>
  .g-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }

  .g-lede {
    margin-top: 1rem;
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .g-preview {
    background: rgb(255 255 255 / 0.85);
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 20px;
    padding: 1.15rem 1.25rem 1.25rem;
    box-shadow: 0 20px 44px -28px rgb(22 22 27 / 0.35);
  }

  .g-preview-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .g-ready {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-emerald);
    letter-spacing: 0.04em;
  }

  .g-ready i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-emerald);
    animation: g-pulse 2.2s ease-in-out infinite;
  }

  @keyframes g-pulse {
    50% { transform: scale(1.35); }
  }

  .g-preview-list {
    list-style: none;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .g-preview-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-ink) 7%, transparent);
    border-radius: 9px;
    padding: 0.42rem 0.65rem;
  }

  .g-preview-list em {
    font-style: normal;
    color: var(--color-ink-3);
  }

  .g-preview p {
    margin-top: 0.9rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .g-shell {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 26px;
    box-shadow: var(--shadow-lift);
    padding: clamp(1.1rem, 3vw, 2rem);
    overflow: clip;
  }

  .g-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .g-status {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    line-height: 1.5;
    color: var(--color-ink-2);
    font-size: 0.92rem;
    max-width: 36rem;
  }

  .g-live-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.42rem;
    border-radius: 50%;
    background: var(--color-emerald);
    box-shadow: 0 0 0 0 rgb(23 131 91 / 0.35);
  }

  .ga4-lab[data-state='running'] .g-live-dot {
    animation: g-ping 1.8s ease-out infinite;
  }

  @keyframes g-ping {
    0% { box-shadow: 0 0 0 0 rgb(23 131 91 / 0.35); }
    70%, 100% { box-shadow: 0 0 0 9px transparent; }
  }

  .g-play {
    flex: none;
    min-height: 3.25rem;
    padding-inline: 1.35rem;
  }

  .g-play-icon {
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 9px solid currentColor;
  }

  .g-play.attn {
    animation: g-play-glow 2.1s ease-in-out infinite;
  }

  @keyframes g-play-glow {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 20%, transparent),
        0 18px 34px -16px color-mix(in srgb, var(--accent) 70%, transparent);
    }
  }

  .g-play:disabled {
    cursor: wait;
    opacity: 0.82;
  }

  .g-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.6rem);
    align-items: stretch;
  }

  .g-kicker {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.8rem;
  }

  .g-rows {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .g-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: 14px;
    padding: 0.8rem 0.95rem;
    transition: border-color 0.4s var(--ease-out), background-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .g-row-icon {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 800;
    color: transparent;
  }

  .g-row[data-state='checking'] {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateX(4px);
  }

  .g-row[data-state='checking'] .g-row-icon {
    border-color: var(--accent);
    border-top-color: transparent;
    animation: g-spin 0.8s linear infinite;
  }

  @keyframes g-spin {
    to { transform: rotate(360deg); }
  }

  .g-row[data-state='issue'] {
    border-color: rgb(217 85 47 / 0.55);
    background: rgb(217 85 47 / 0.06);
  }

  .g-row[data-state='issue'] .g-row-icon {
    border-color: var(--color-coral);
    color: var(--color-coral);
  }

  .g-row[data-state='passed'] {
    border-color: rgb(23 131 91 / 0.4);
  }

  .g-row[data-state='passed'] .g-row-icon {
    background: var(--color-emerald);
    border-color: var(--color-emerald);
    color: #fff;
  }

  .g-row-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .g-row-main b {
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  .g-row-main small {
    font-size: 0.74rem;
    color: var(--color-ink-2);
    line-height: 1.4;
  }

  .g-params {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .g-chip {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    background: color-mix(in srgb, var(--color-ink) 8%, #fff);
    color: var(--color-ink-3);
  }

  .g-row[data-state='checking'] .g-chip {
    background: color-mix(in srgb, var(--accent) 16%, #fff);
    color: var(--accent);
  }

  .g-row[data-state='issue'] .g-chip {
    background: rgb(217 85 47 / 0.14);
    color: var(--color-coral);
  }

  .g-row[data-state='passed'] .g-chip {
    background: rgb(23 131 91 / 0.14);
    color: var(--color-emerald);
  }

  .g-debug {
    background: linear-gradient(165deg, #15151c, #1d1c28 75%);
    color: #fff;
    border-radius: 18px;
    padding: 1.1rem 1.2rem;
    box-shadow: var(--shadow-panel);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .g-debug-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
    margin-bottom: 0.9rem;
  }

  .g-debug-count b {
    color: #7ee2b8;
    font-size: 0.85rem;
  }

  .g-log {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.82);
  }

  .g-log li {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
    animation: g-log-in 0.45s var(--ease-out);
  }

  .g-log li span {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7ee2b8;
  }

  .g-log li.is-issue span {
    color: #ffb59d;
  }

  @keyframes g-log-in {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: none; }
  }

  .g-debug-foot {
    margin-top: auto;
    padding-top: 1rem;
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 1rem;
    align-items: end;
  }

  .g-debug-foot span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .g-debug-foot b {
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }

  .g-verdict {
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.85);
  }

  .g-note {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }

  @media (max-width: 64rem) {
    .g-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .g-preview {
      max-width: 38rem;
    }
  }

  @media (max-width: 56rem) {
    .g-grid {
      grid-template-columns: 1fr;
    }

    .g-debug-foot {
      grid-template-columns: auto auto;
    }

    .g-verdict {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34rem) {
    .g-shell {
      border-radius: 20px;
      padding: 0.9rem;
    }

    .g-play {
      width: 100%;
      justify-content: center;
    }

    .g-row {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .g-ready i, .g-live-dot, .g-play.attn, .g-log li,
    .g-row[data-state='checking'] .g-row-icon {
      animation: none;
    }

    .g-row {
      transition: none;
    }
  }
</style>
