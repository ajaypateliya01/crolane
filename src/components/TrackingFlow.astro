---
/**
 * Behaviour analytics visual: a simulated visitor journey across a viewport
 * with stage timeline, event log, heatmap overlay and friction annotation.
 */
const stages = [
  { id: 'enter', label: 'Enter', event: 'page_view · /collections/summer' },
  { id: 'browse', label: 'Browse', event: 'view_item · linen overshirt' },
  { id: 'engage', label: 'Engage', event: 'click · size guide opens' },
  { id: 'hesitate', label: 'Hesitate', event: 'scroll_75 · cart button in view' },
  { id: 'act', label: 'Act', event: 'add_to_cart · overshirt / M' },
];
---

<section class="section tracking tone-paper" aria-labelledby="track-title">
  <div class="container-x">
    <header class="track-head">
      <div>
        <p class="eyebrow eyebrow--accent" style="--accent: var(--color-coral);" data-reveal="fade">
          Conversion tracking & behaviour
        </p>
        <h2 class="display-lg" id="track-title" data-reveal>
          Follow one journey, not just <span class="display-italic">the totals</span>.
        </h2>
      </div>
      <p class="lede" data-reveal data-reveal-delay="0.08">
        Aggregates tell you that people leave. A traced journey suggests where and why, so the
        next investigation has somewhere to start.
      </p>
    </header>

    <div
      class="viz-stage track-stage"
      data-track
      data-reveal="scale"
      style="--accent: var(--color-coral);"
    >
      <div class="viz-chrome">
        <div class="viz-chrome-left">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="viz-url">demo-brand.example / collections / summer</span>
        </div>
        <div class="track-actions">
          <span class="viz-note">Illustrative sample data</span>
          <button class="btn btn-ghost btn-sm" type="button" data-heat-toggle aria-pressed="false">
            Show attention map
          </button>
          <button class="btn btn-ghost btn-sm" type="button" data-track-pause aria-pressed="false"
            >Pause</button
          >
        </div>
      </div>

      <div class="track-body">
        <!-- Simulated viewport -->
        <div class="track-viewport" data-viewport>
          <div class="vp-page" aria-hidden="true">
            <div class="vp-nav"><i class="vp-logo"></i><i></i><i></i><i></i><b></b></div>
            <div class="vp-hero">
              <div class="vp-hero-copy">
                <span class="vp-eyebrow"></span>
                <span class="vp-h1"></span>
                <span class="vp-h1 short"></span>
                <span class="vp-cta"></span>
              </div>
              <div class="vp-hero-img"></div>
            </div>
            <div class="vp-grid">
              <figure class="vp-card hot">
                <div class="vp-card-img"></div>
                <span class="vp-card-line"></span>
                <span class="vp-card-line short"></span>
              </figure>
              <figure class="vp-card">
                <div class="vp-card-img alt"></div>
                <span class="vp-card-line"></span>
                <span class="vp-card-line short"></span>
              </figure>
              <figure class="vp-card">
                <div class="vp-card-img alt2"></div>
                <span class="vp-card-line"></span>
                <span class="vp-card-line short"></span>
              </figure>
            </div>
            <div class="vp-detail">
              <div class="vp-detail-media"></div>
              <div class="vp-detail-copy">
                <span class="vp-card-line"></span>
                <span class="vp-card-line short"></span>
                <button class="vp-size" type="button" tabindex="-1">Size guide</button>
                <span class="vp-buy" data-vp-buy>Add to bag</span>
              </div>
            </div>
          </div>

          <!-- heatmap -->
          <div class="vp-heat" data-heat aria-hidden="true"></div>

          <!-- friction annotation -->
          <div class="annot track-annot" data-track-annot>
            <span class="pin"></span><span class="annot-label">Repeated hesitation (demo)</span>
          </div>

          <!-- cursor -->
          <div class="vp-cursor" data-cursor aria-hidden="true">
            <svg width="22" height="24" viewBox="0 0 22 24" fill="none">
              <path
                d="M3 2l15 10.2-6.6 1.3L9.6 21z"
                fill="#16161b"
                stroke="#fff"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            </svg>
            <span class="cursor-click" data-cursor-click></span>
          </div>

          <div class="vp-progress" aria-hidden="true">
            <span data-scroll-bar></span>
          </div>
        </div>

        <!-- Timeline + log -->
        <aside class="track-side">
          <p class="label-mono">Journey timeline</p>
          <ol class="stage-list" data-stages>
            {
              stages.map((s) => (
                <li data-stage={s.id}>
                  <span class="stage-dot" aria-hidden="true" />
                  <span class="stage-meta">
                    <span class="stage-label">{s.label}</span>
                    <span class="stage-event">{s.event}</span>
                  </span>
                </li>
              ))
            }
          </ol>

          <div class="track-callout" data-callout>
            <p class="label-mono">Worth investigating</p>
            <p>
              Size guide activity spikes just before hesitation. A clearer fit section might be
              worth testing.
            </p>
          </div>

          <p class="track-legal">
            Simulated behaviour for demonstration. Not real user recordings, and no real visitor
            data is collected on this site.
          </p>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/tracking';
</script>

<style>
  .tracking {
    background:
      radial-gradient(70% 45% at 90% 8%, rgb(217 85 47 / 0.06), transparent 60%),
      var(--color-paper);
    overflow: clip;
  }

  .track-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .track-head h2 {
    margin-top: 1.1rem;
    max-width: 16ch;
  }

  .track-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .track-body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 1.1rem;
    padding: 1.2rem;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  /* Viewport ------------------------------------------------------------ */
  .track-viewport {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    min-height: 30rem;
    box-shadow: var(--shadow-soft);
  }

  .vp-page {
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: filter 0.5s var(--ease-out);
  }

  .vp-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .vp-nav i {
    width: 30px;
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  .vp-nav .vp-logo {
    width: 52px;
    height: 9px;
    background: var(--color-ink);
    opacity: 0.85;
    margin-right: auto;
  }

  .vp-nav b {
    width: 14px;
    height: 14px;
    border: 1.6px solid color-mix(in srgb, var(--color-ink) 45%, transparent);
    border-radius: 5px;
  }

  .vp-hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 0.8rem;
    background: linear-gradient(140deg, #f6f2ec, #eef1f7);
    border-radius: 12px;
    padding: 1.1rem;
    min-height: 9.5rem;
  }

  .vp-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .vp-eyebrow {
    width: 70px;
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-coral) 70%, #fff);
  }

  .vp-h1 {
    height: 13px;
    width: 85%;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }

  .vp-h1.short {
    width: 55%;
  }

  .vp-cta {
    height: 24px;
    width: 110px;
    border-radius: 999px;
    background: var(--color-ink);
    margin-top: 6px;
  }

  .vp-hero-img {
    border-radius: 9px;
    background: linear-gradient(150deg, #dfe4ee, #cfd6e4);
  }

  .vp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .vp-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: 10px;
    background: #fff;
    transition: border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .vp-card.hot {
    border-color: color-mix(in srgb, var(--color-coral) 55%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-coral) 12%, transparent);
  }

  .vp-card-img {
    aspect-ratio: 4 / 3.4;
    border-radius: 7px;
    background: linear-gradient(150deg, #e9e2d6, #d8cfc0);
  }

  .vp-card-img.alt {
    background: linear-gradient(150deg, #dfe7df, #c9d6cb);
  }

  .vp-card-img.alt2 {
    background: linear-gradient(150deg, #e5e0ef, #d0c9e2);
  }

  .vp-card-line {
    height: 7px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .vp-card-line.short {
    width: 55%;
  }

  .vp-detail {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 0.8rem;
    padding: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: 12px;
  }

  .vp-detail-media {
    border-radius: 9px;
    background: linear-gradient(150deg, #eee6da, #ddd2c2);
    min-height: 6rem;
  }

  .vp-detail-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .vp-size {
    align-self: flex-start;
    font-size: 0.66rem;
    padding: 0.3rem 0.6rem;
    border-radius: 7px;
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 40%, transparent);
    background: #fff;
    cursor: default;
  }

  .vp-buy {
    height: 26px;
    width: 130px;
    border-radius: 8px;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.64rem;
    font-weight: 620;
    display: grid;
    place-items: center;
    transition: transform 0.3s var(--ease-out);
  }

  [data-stage-active='hesitate'] .vp-buy {
    animation: buy-nudge 0.5s var(--ease-out) 2;
  }

  @keyframes buy-nudge {
    50% {
      transform: translateY(2px) scale(0.985);
    }
  }

  /* Heatmap */
  .vp-heat {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out);
    background:
      radial-gradient(16% 12% at 24% 30%, rgb(217 85 47 / 0.5), transparent 70%),
      radial-gradient(13% 10% at 62% 24%, rgb(233 140 40 / 0.45), transparent 70%),
      radial-gradient(20% 14% at 48% 58%, rgb(226 90 45 / 0.42), transparent 70%),
      radial-gradient(11% 9% at 30% 78%, rgb(240 170 60 / 0.4), transparent 70%),
      radial-gradient(24% 16% at 70% 84%, rgb(217 85 47 / 0.3), transparent 72%);
    mix-blend-mode: multiply;
    filter: blur(6px);
  }

  .track-stage[data-heat='true'] .vp-heat {
    opacity: 1;
  }

  .track-stage[data-heat='true'] .vp-page {
    filter: saturate(0.65);
  }

  /* Cursor */
  .vp-cursor {
    position: absolute;
    left: 14%;
    top: 12%;
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.3));
    transition: left 1.15s var(--ease-out), top 1.15s var(--ease-out);
    z-index: 4;
    display: none;
  }

  .track-stage:not([data-reduced]) .vp-cursor {
    display: block;
  }

  .cursor-click {
    position: absolute;
    left: 50%;
    top: 60%;
    width: 30px;
    height: 30px;
    border: 2px solid var(--color-coral);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0.2);
    opacity: 0;
  }

  .vp-cursor.clicking .cursor-click {
    animation: click-ring 0.55s var(--ease-out);
  }

  @keyframes click-ring {
    from {
      transform: translate(-50%, -50%) scale(0.25);
      opacity: 1;
    }
    to {
      transform: translate(-50%, -50%) scale(1.4);
      opacity: 0;
    }
  }

  /* Scroll progress */
  .vp-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .vp-progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--color-coral), var(--color-amber));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s var(--ease-out);
  }

  /* Annotation */
  .track-annot {
    left: 46%;
    bottom: 26%;
    z-index: 5;
  }

  /* Side panel ----------------------------------------------------------- */
  .track-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 16px;
    padding: 1.15rem 1.2rem;
    box-shadow: var(--shadow-soft);
    min-width: 0;
  }

  .stage-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stage-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.6rem 0.4rem;
    border-radius: 10px;
    opacity: 0.42;
    transition: opacity 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
    position: relative;
  }

  .stage-list li::after {
    content: '';
    position: absolute;
    left: 12px;
    top: calc(50% + 12px);
    height: calc(100% - 12px);
    border-left: 1.5px dashed color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .stage-list li:last-child::after {
    display: none;
  }

  .stage-list li.done,
  .stage-list li.active {
    opacity: 1;
  }

  .stage-list li.active {
    background: color-mix(in srgb, var(--color-coral) 7%, #fff);
  }

  .stage-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 3px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    background: #fff;
    flex: none;
    margin-top: 0.25rem;
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
    z-index: 1;
  }

  .stage-list li.done .stage-dot {
    border-color: var(--color-emerald);
    background: var(--color-emerald);
  }

  .stage-list li.active .stage-dot {
    border-color: var(--color-coral);
    background: #fff;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-coral) 18%, transparent);
  }

  .stage-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .stage-label {
    font-size: 0.9rem;
    font-weight: 590;
  }

  .stage-event {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stage-list li.active .stage-event {
    color: var(--color-coral);
  }

  .track-callout {
    margin-top: auto;
    background: color-mix(in srgb, var(--color-amber) 8%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-amber) 35%, transparent);
    border-radius: 12px;
    padding: 0.85rem 0.95rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }

  .track-callout.show {
    opacity: 1;
    transform: none;
  }

  .track-callout .label-mono {
    color: var(--color-amber);
    margin-bottom: 0.35rem;
  }

  .track-callout p:last-child {
    font-size: 0.83rem;
    color: var(--color-ink-2);
    line-height: 1.55;
  }

  .track-legal {
    font-size: 0.72rem;
    color: var(--color-ink-3);
    line-height: 1.5;
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
    padding-top: 0.75rem;
  }

  /* Responsive */
  @media (max-width: 64rem) {
    .track-body {
      grid-template-columns: 1fr;
    }

    .track-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 40rem) {
    .track-viewport {
      min-height: 24rem;
    }

    .vp-hero {
      grid-template-columns: 1fr;
    }

    .vp-hero-img {
      min-height: 5rem;
    }

    .vp-grid {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-click,
    .vp-buy {
      animation: none !important;
    }
  }
</style>
