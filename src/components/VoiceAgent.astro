---
/**
 * AI voice agent demonstration: a user-triggered call simulation with a
 * waveform, labelled conversation turns, captured details and an
 * out-of-hours script variant. No audio plays, ever.
 */
const capabilities = [
  'Answers incoming calls',
  'Routine questions from approved information',
  'Captures name, number and reason',
  'Basic appointment or quote requests where supported',
  'Out-of-hours information',
];
---

<section
  class="section voice tone-cream"
  aria-labelledby="voice-title"
  data-voice
  style="--accent: var(--color-violet);"
>
  <div class="container-x">
    <header class="vo-head">
      <div>
        <p class="eyebrow eyebrow--accent" data-reveal="fade">AI voice agents</p>
        <h2 class="display-lg" id="voice-title" data-reveal>
          The same calm answer, <span class="display-italic">every time it rings</span>.
        </h2>
      </div>
      <p class="lede" data-reveal data-reveal-delay="0.08">
        A voice agent handles the routine layer of a call: the questions you have already
        approved, the details you always need, and a clear record of what was asked. Press play
        to watch a sample conversation.
      </p>
    </header>

    <div class="viz-stage vo-stage" data-reveal="scale">
      <div class="viz-chrome">
        <div class="viz-chrome-left">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="viz-url">voice.demo / incoming / sample call</span>
        </div>
        <div class="vo-actions">
          <div class="seg" role="group" aria-label="Call scenario">
            <button type="button" data-vo-mode="hours" aria-pressed="true">Business hours</button>
            <button type="button" data-vo-mode="after" aria-pressed="false">After hours</button>
          </div>
          <span class="viz-note">Illustrative demo</span>
        </div>
      </div>

      <div class="vo-body">
        <!-- Call panel -->
        <div class="vo-call">
          <div class="call-top">
            <div class="call-avatar" data-vo-avatar aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                <path
                  d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <div class="call-meta">
              <p class="call-state" data-vo-state>Sample call ready</p>
              <p class="call-number">Incoming · +91 ••••• 4210</p>
            </div>
            <p class="call-timer" data-vo-timer aria-live="off">00:00</p>
          </div>

          <div class="voice-wave" data-vo-wave aria-hidden="true">
            {
              Array.from({ length: 32 }).map((_, i) => (
                <span class="bar" style={`--i:${i}`} />
              ))
            }
          </div>

          <div class="vo-caller-card">
            <p class="label-mono">Caller enquiry</p>
            <p data-vo-inquiry>Quote request for a studio project, Thursday preferred.</p>
          </div>

          <div class="vo-capture" data-vo-capture hidden>
            <p class="label-mono">Captured during the call</p>
            <ul>
              <li><span>Name</span><strong data-cap-name>Priya M.</strong></li>
              <li><span>Number</span><strong>+91 ••••• 4210</strong></li>
              <li><span>Intent</span><strong data-cap-intent>Quote request</strong></li>
              <li><span>Next step</span><strong data-cap-next>Thursday, 3:30 PM hold</strong></li>
            </ul>
          </div>

          <button class="btn btn-primary vo-play" type="button" data-vo-play>
            <svg width="12" height="13" viewBox="0 0 12 13" aria-hidden="true">
              <path d="M1.5 1.8v9.4L10.5 6.5z" fill="currentColor"></path>
            </svg>
            Play demo call
          </button>
          <p class="vo-audio-note">Silent demonstration: no audio is played and no real calls are made.</p>
        </div>

        <!-- Conversation -->
        <div class="vo-thread">
          <div class="thread-head">
            <p class="label-mono">Conversation</p>
            <span class="status" data-vo-status>waiting</span>
          </div>
          <ol class="turns" data-vo-turns>
            <li class="turn agent" data-static-turn>
              <span class="who">Agent</span>
              <p>Thanks for calling, this is the virtual receptionist for Demo Studio. How can I help?</p>
            </li>
            <li class="turn caller" data-static-turn>
              <span class="who">Caller</span>
              <p>Hi, do you have appointments available this week?</p>
            </li>
            <li class="turn agent" data-static-turn>
              <span class="who">Agent</span>
              <p>Yes. I can check availability for you. Which day works best?</p>
            </li>
            <li class="turn caller" data-static-turn>
              <span class="who">Caller</span>
              <p>Thursday afternoon, please.</p>
            </li>
            <li class="turn agent" data-static-turn>
              <span class="who">Agent</span>
              <p>Thursday at 3:30 PM is open. May I take your name and number to hold it?</p>
            </li>
            <li class="turn caller" data-static-turn>
              <span class="who">Caller</span>
              <p>Priya, on the number that is calling.</p>
            </li>
            <li class="turn agent" data-static-turn>
              <span class="who">Agent</span>
              <p>Held for Priya. You will get a confirmation message shortly. Anything else I can check?</p>
            </li>
          </ol>

          <div class="vo-summary" data-vo-summary hidden>
            <p class="label-mono">Call summary</p>
            <p>
              Routine enquiry handled from approved information, details captured, next step
              recorded for the team.
            </p>
          </div>
        </div>
      </div>

      <div class="vo-scope">
        <ul class="vo-caps" aria-label="What this demonstration covers">
          {capabilities.map((c) => <li>{c}</li>)}
        </ul>
        <p class="vo-limit">
          Scope note: this is a demonstration, not a live phone line. Advanced call routing,
          live calendar synchronisation and deep CRM integrations are not standard inclusions;
          what is possible depends on the platform selected, your requirements and a
          project-specific feasibility review.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/voice';
</script>

<style>
  .voice {
    background:
      radial-gradient(75% 50% at 85% 0%, rgb(124 77 255 / 0.07), transparent 60%),
      var(--color-paper-2);
    overflow: clip;
  }

  .vo-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .vo-head h2 {
    margin-top: 1.1rem;
    max-width: 17ch;
  }

  .vo-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .vo-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1rem, 2.5vw, 1.5rem);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  /* Call panel ----------------------------------------------------------- */
  .vo-call {
    background: linear-gradient(165deg, #17171d, #1c1b26 70%);
    color: #fff;
    border-radius: 16px;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    box-shadow: var(--shadow-panel);
    min-width: 0;
  }

  .call-top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .call-avatar {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-violet) 30%, #26243a);
    color: #cdb9ff;
    border: 1px solid color-mix(in srgb, var(--color-violet) 55%, transparent);
    position: relative;
    flex: none;
  }

  [data-vo-state].ringing ~ * .call-avatar,
  .vo-call[data-call-state='ringing'] .call-avatar {
    animation: ring-pulse 1.2s ease-in-out infinite;
  }

  .vo-call[data-call-state='active'] .call-avatar {
    background: color-mix(in srgb, var(--color-emerald) 32%, #1d2a24);
    color: #9fe3c6;
    border-color: color-mix(in srgb, var(--color-emerald) 60%, transparent);
  }

  .vo-call[data-call-state='done'] .call-avatar {
    background: color-mix(in srgb, var(--color-amber) 30%, #2a241d);
    color: #ffd9a8;
    border-color: color-mix(in srgb, var(--color-amber) 60%, transparent);
  }

  @keyframes ring-pulse {
    50% {
      box-shadow: 0 0 0 10px rgb(124 77 255 / 0.14);
    }
  }

  .call-meta {
    min-width: 0;
    flex: 1;
  }

  .call-state {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .call-number {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgb(255 255 255 / 0.55);
    margin-top: 0.15rem;
  }

  .call-timer {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.7);
    background: rgb(255 255 255 / 0.07);
    border-radius: 8px;
    padding: 0.3rem 0.55rem;
  }

  /* Waveform */
  .voice-wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 4.5rem;
    padding: 0 0.25rem;
  }

  .voice-wave .bar {
    flex: 1;
    height: 16%;
    border-radius: 99px;
    background: color-mix(in srgb, var(--color-violet) 65%, #fff 10%);
    transition: height 0.3s var(--ease-out), background 0.4s var(--ease-out);
  }

  .voice-wave.speaking-agent .bar {
    animation: wave-agent 0.9s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.07s);
    background: #b9a1ff;
  }

  .voice-wave.speaking-caller .bar {
    animation: wave-caller 1.05s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.055s);
    background: rgb(255 255 255 / 0.75);
  }

  @keyframes wave-agent {
    from {
      height: 12%;
    }
    to {
      height: calc(30% + (var(--i) % 5) * 13%);
    }
  }

  @keyframes wave-caller {
    from {
      height: 10%;
    }
    to {
      height: calc(24% + (var(--i) % 4) * 10%);
    }
  }

  .vo-caller-card,
  .vo-capture {
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
  }

  .vo-caller-card .label-mono,
  .vo-capture .label-mono {
    color: rgb(255 255 255 / 0.5);
    margin-bottom: 0.35rem;
  }

  .vo-caller-card p:last-child {
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.85);
    line-height: 1.5;
  }

  .vo-capture ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .vo-capture li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    border-bottom: 1px dashed rgb(255 255 255 / 0.12);
    padding-bottom: 0.4rem;
  }

  .vo-capture li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .vo-capture li span {
    color: rgb(255 255 255 / 0.5);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .vo-capture li strong {
    font-weight: 570;
    color: #e7ddff;
    text-align: right;
  }

  .vo-play {
    align-self: stretch;
    background: #fff;
    color: var(--color-ink);
  }

  .vo-play:hover {
    background: #efeaff;
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  .vo-audio-note {
    font-size: 0.7rem;
    color: rgb(255 255 255 / 0.45);
    text-align: center;
    margin-top: -0.4rem;
  }

  /* Thread ---------------------------------------------------------------- */
  .vo-thread {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 16px;
    padding: clamp(1.1rem, 2.5vw, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    box-shadow: var(--shadow-soft);
    min-width: 0;
  }

  .thread-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .turns {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-height: 17rem;
  }

  .turn {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 88%;
    opacity: 1;
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .turn.hidden-turn {
    display: none;
  }

  .turn.enter {
    opacity: 0;
    transform: translateY(8px);
  }

  .turn .who {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .turn p {
    padding: 0.6rem 0.85rem;
    border-radius: 14px;
    font-size: 0.89rem;
    line-height: 1.55;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: var(--color-paper);
  }

  .turn.agent {
    align-self: flex-start;
    align-items: flex-start;
  }

  .turn.agent p {
    background: color-mix(in srgb, var(--color-violet) 8%, #fff);
    border-color: color-mix(in srgb, var(--color-violet) 25%, transparent);
  }

  .turn.agent .who {
    color: color-mix(in srgb, var(--color-violet) 75%, var(--color-ink));
  }

  .turn.caller {
    align-self: flex-end;
    align-items: flex-end;
    text-align: right;
  }

  .turn.caller p {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
    text-align: left;
  }

  .vo-summary {
    background: color-mix(in srgb, var(--color-emerald) 8%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-emerald) 30%, transparent);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
    margin-top: auto;
  }

  .vo-summary .label-mono {
    color: var(--color-emerald);
    margin-bottom: 0.3rem;
  }

  .vo-summary p:last-child {
    font-size: 0.85rem;
    color: var(--color-ink-2);
    line-height: 1.55;
  }

  /* Scope ----------------------------------------------------------------- */
  .vo-scope {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: rgb(255 255 255 / 0.85);
    padding: 1.1rem clamp(1rem, 2.5vw, 1.5rem) 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .vo-caps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vo-caps li {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-violet) 30%, transparent);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
  }

  .vo-limit {
    font-size: 0.78rem;
    color: var(--color-ink-3);
    line-height: 1.55;
    max-width: 56rem;
  }

  /* Responsive */
  @media (max-width: 64rem) {
    .vo-body {
      grid-template-columns: 1fr;
    }

    .vo-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .voice-wave.speaking-agent .bar,
    .voice-wave.speaking-caller .bar,
    .call-avatar {
      animation: none !important;
    }

    .voice-wave .bar {
      height: 30%;
    }
  }
</style>
