---
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 30, withWordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    class="logo-mark"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M3.5 16c5 0 7.5 0 10.5 0 4.2 0 4-8 12.5-8"
      stroke="var(--color-indigo)"
      stroke-width="2.4"
      stroke-linecap="round"></path>
    <path
      d="M3.5 16c5 0 7.5 0 10.5 0 4.2 0 4 8 12.5 8"
      stroke="var(--color-ink)"
      stroke-width="2.4"
      stroke-linecap="round"></path>
    <circle cx="14" cy="16" r="3.1" fill="var(--color-ink)"></circle>
    <circle cx="27.2" cy="7.9" r="2.4" fill="var(--color-amber)"></circle>
    <circle cx="27.2" cy="24.1" r="2.4" fill="var(--color-ink)" fill-opacity="0.45"
    ></circle>
  </svg>
  {
    withWordmark && (
      <span class="logo-word" aria-hidden="true">
        CROLANE
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo-mark {
    flex: none;
    overflow: visible;
  }

  .logo-word {
    font-weight: 640;
    font-size: 1.02rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1;
  }
</style>
