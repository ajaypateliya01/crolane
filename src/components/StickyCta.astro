---
// Mobile-only bar that slides in after the hero.
const path = Astro.url.pathname;
const show = !path.startsWith('/contact') && !path.startsWith('/keystatic');
---
{show && (
  <div class="mcta" id="mcta">
    <a class="btn btn-ink" href="#mini-audit" data-track="sticky_audit">Free audit</a>
    <a class="btn btn-white" href="/contact/" data-track="sticky_contact">Talk to Ajay</a>
  </div>
)}
