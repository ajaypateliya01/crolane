---
import CtaBand from '../CtaBand.astro';
import type { Service } from '../../config/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<CtaBand
  eyebrow={`Start with ${service.navTitle}`}
  title="Send your URL. Get a clear quote within 24 hours."
  copy="A short note about the problem is enough. You get a fixed price, a timeline and what access is needed. No sales call required."
  primaryLabel="Get a quote"
  primaryHref={`/contact/?service=${service.id}`}
/>
