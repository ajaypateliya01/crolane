---
import type { Service } from '../../config/services';

interface Props {
  service: Service;
  lede: string;
  artAlt: string;
}
const { service, lede, artAlt } = Astro.props;
---

<section
  class="sv-hero"
  style={`--accent:${service.accent}; --soft:${service.accentSoft};`}
  aria-labelledby="sv-title"
>
  <div class="sv-hero-bg" aria-hidden="true"></div>
  <div class="container-x sv-hero-grid">
    <div class="sv-hero-copy">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{service.navTitle}</span>
      </nav>
      <p class="eyebrow eyebrow--accent" data-reveal="fade">
        Service {service.num} · {service.navTitle}
      </p>
      <h1 class="display-lg" id="sv-title" data-reveal>{service.title}</h1>
      <p class="lede" data-reveal data-reveal-delay="0.08">{lede}</p>
      <div class="sv-hero-actions" data-reveal data-reveal-delay="0.16">
        <a class="btn btn-primary" href="/contact/">Discuss this service</a>
        <a class="btn btn-ghost" href="/services/">All services</a>
      </div>
    </div>
    <figure class="sv-hero-art" data-reveal="scale" data-reveal-delay="0.1">
      <img
        src={service.art}
        alt={artAlt}
        width="640"
        height="480"
        loading="eager"
      />
      <span class="sv-fx" aria-hidden="true">
        <span class="sv-scan"></span>
        <span class="sv-ring sv-ring--a"></span>
        <span class="sv-ring sv-ring--b"></span>
        <span class="sv-bars"><b></b><b></b><b></b><b></b></span>
      </span>
      <figcaption class="sv-art-caption">
        <span class="chip"><span class="chip-dot"></span>Custom visual · {service.navTitle}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .sv-hero {
    position: relative;
    padding-top: clamp(7.5rem, 14vh, 10rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    background: var(--color-paper);
    overflow: clip;
  }

  .sv-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 85% 20%, color-mix(in srgb, var(--soft) 85%, transparent), transparent 70%),
      radial-gradient(45% 55% at 10% 90%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%);
    pointer-events: none;
  }

  .sv-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .sv-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.3rem;
  }

  .crumb {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 0.6rem;
  }

  .crumb a {
    color: var(--color-ink-3);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: transparent;
    transition: color 0.25s var(--ease-out), text-decoration-color 0.25s var(--ease-out);
  }

  .crumb a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .sv-hero h1 {
    max-width: 18ch;
  }

  .sv-hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .sv-hero-art {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    box-shadow: var(--shadow-lift);
    background: var(--soft);
    aspect-ratio: 4 / 3.2;
  }

  .sv-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: sv-kenburns 16s ease-in-out infinite alternate;
  }

  @keyframes sv-kenburns {
    from { transform: scale(1.05) translate(-1%, -1%); }
    to { transform: scale(1.13) translate(1.2%, 1%) rotate(0.4deg); }
  }

  .sv-hero-art:hover img {
    animation-play-state: paused;
  }

  .sv-hero-art:hover .sv-scan {
    animation-duration: 1.7s;
  }

  .sv-hero-art:hover .sv-ring {
    animation-duration: 1.3s;
  }

  .sv-hero-art:hover .sv-bars b {
    animation-duration: 1s;
  }

  /* Animated layer over every service hero visual: scan beam, pulse
     rings and breathing bars in the service accent. */
  .sv-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sv-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 36%;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 24%, transparent), transparent);
    animation: sv-scan 5.6s ease-in-out infinite;
  }

  @keyframes sv-scan {
    0%, 100% { transform: translateY(0); opacity: 0; }
    20% { opacity: 1; }
    55% { transform: translateY(310%); opacity: 1; }
    75%, 99% { opacity: 0; }
  }

  .sv-ring {
    position: absolute;
    border: 1.5px solid color-mix(in srgb, var(--accent) 65%, #fff);
    border-radius: 50%;
    opacity: 0;
    animation: sv-ring 3.4s ease-out infinite;
  }

  .sv-ring--a { width: 54px; height: 54px; top: 16%; right: 14%; }
  .sv-ring--b { width: 38px; height: 38px; bottom: 22%; left: 10%; animation-delay: 1.6s; }

  @keyframes sv-ring {
    0% { transform: scale(0.5); opacity: 0.85; }
    70%, 100% { transform: scale(1.5); opacity: 0; }
  }

  .sv-bars {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    padding: 0.55rem 0.6rem;
    background: rgb(19 19 24 / 0.42);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 10px;
    backdrop-filter: blur(3px);
  }

  .sv-bars b {
    width: 5px;
    border-radius: 3px;
    background: #fff;
    animation: sv-bar 2.8s ease-in-out infinite;
  }

  .sv-bars b:nth-child(1) { height: 9px; }
  .sv-bars b:nth-child(2) { height: 15px; animation-delay: -0.4s; }
  .sv-bars b:nth-child(3) { height: 21px; animation-delay: -0.8s; }
  .sv-bars b:nth-child(4) { height: 13px; animation-delay: -1.2s; }

  @keyframes sv-bar {
    0%, 100% { transform: scaleY(0.55); }
    50% { transform: scaleY(1.15); }
  }

  .sv-art-caption .chip {
    animation: sv-chip-float 4.5s ease-in-out infinite;
  }

  @keyframes sv-chip-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-hero-art img, .sv-scan, .sv-ring, .sv-bars b, .sv-art-caption .chip {
      animation: none;
    }
  }

  .sv-art-caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
  }

  @media (max-width: 64rem) {
    .sv-hero-grid {
      grid-template-columns: 1fr;
    }

    .sv-hero-art {
      max-width: 34rem;
      aspect-ratio: 16 / 10;
    }
  }
</style>
