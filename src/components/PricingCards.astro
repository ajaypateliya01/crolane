---
import bfcm from '../content/settings/bfcm.json';
import pricing from '../content/settings/pricing.json';

interface Props {
  /** Compact cards for teasers: hides the feature list. */
  compact?: boolean;
  /** 'sale' shows the BFCM packages, 'regular' the everyday sprint packages. */
  mode?: 'sale' | 'regular';
}
const { compact = false, mode = 'sale' } = Astro.props;
const sale = mode === 'sale';
// Everyday packages have no regular price line; give them a matching shape.
const packages = sale
  ? bfcm.packages.map((p) => ({ ...p, service: '' }))
  : pricing.packages.map((p) => ({ ...p, regularPrice: 0 }));
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<div class:list={['pc-grid', { 'pc-compact': compact }]} data-reveal-group>
  {
    packages.map((p) => (
      <article class:list={['pc-card', { 'pc-hi': p.highlight }]}>
        {p.badge && <span class="pc-badge">{p.badge}</span>}
        <h3 class="pc-name">{p.name}</h3>
        <p class="pc-summary">{p.summary}</p>
        <div class="pc-price">
          <span class="pc-now">{money(p.price)}</span>
          {sale && p.regularPrice > p.price && (
            <span class="pc-reg">
              Regular {money(p.regularPrice)} from Dec 1
            </span>
          )}
        </div>
        <p class="pc-delivery">{p.delivery}</p>
        {!compact && (
          <ul class="pc-list">
            {p.features.map((f) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
        )}
        <a
          class:list={['btn', p.highlight ? 'btn-primary' : 'btn-ghost', 'pc-cta']}
          href={sale ? `/contact/?package=${p.id}` : `/contact/?service=${p.service}`}
          data-track="select_package"
          data-track-label={p.name}
          data-track-value={p.price}
        >
          Claim {p.name}
        </a>
      </article>
    ))
  }
</div>

<style>
  .pc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .pc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.9rem 1.6rem 1.6rem;
    border-radius: 22px;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .pc-hi {
    border: 2px solid var(--color-signal);
    box-shadow: 0 0 0 4px rgb(242 84 27 / 0.12);
    transform: translateY(-8px);
  }

  .pc-badge {
    position: absolute;
    top: -0.8rem;
    left: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-indigo);
    border-radius: 999px;
    padding: 0.32rem 0.7rem;
  }

  .pc-card:not(.pc-hi) .pc-badge {
    background: var(--color-ink);
  }

  .pc-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .pc-summary {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    min-height: 2.9em;
  }

  .pc-price {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.4rem 0;
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
    padding-top: 0.9rem;
  }

  .pc-now {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .pc-reg {
    font-size: 0.8rem;
    color: var(--color-ink-3);
  }

  .pc-delivery {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emerald);
  }

  .pc-list {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: var(--color-ink-2);
    flex: 1;
  }

  .pc-list li {
    display: flex;
    gap: 0.55rem;
    line-height: 1.45;
  }

  .pc-list svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--color-indigo);
  }

  .pc-cta {
    margin-top: auto;
    width: 100%;
    justify-content: center;
  }

  .pc-compact .pc-summary {
    min-height: 0;
  }

  @media (max-width: 60rem) {
    .pc-grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
      margin-inline: auto;
    }

    .pc-hi {
      transform: none;
      order: -1;
    }
  }
</style>
