---
/**
 * Homepage service showcase: floating mosaic cards, each with its own
 * artwork, accent hue and a gentle idle float. Hover lifts the card and
 * wakes the accent; the group staggers in on scroll.
 */
import { SERVICES } from '../config/services';

const LIVE: Record<string, string[]> = {
  'cro-audit': ['Scanning the journey', 'Friction spotted', 'Fix prioritised'],
  'ab-testing': ['Variant live', 'Traffic splitting', 'Reading the result'],
  'ga4-tag-manager': ['Events firing', 'Tags verified', 'Data flowing in'],
  'conversion-tracking': ['Clicks mapped', 'Heat building', 'Drop-off spotted'],
  'ai-automation': ['Workflow running', 'Steps automated', 'Summary delivered'],
  'ai-voice-agents': ['Call answered', 'Listening carefully', 'Details captured'],
  'shopify-audits': ['Storefront scan', 'Cart checked', 'Friction flagged'],
};
---

<section class="section services-index" aria-labelledby="services-title">
  <div class="container-x">
    <header class="si-head">
      <div>
        <p class="eyebrow" data-reveal="fade">What we do</p>
        <h2 class="display-lg" id="services-title" data-reveal>
          Pick the problem. <span class="display-italic">We bring the method.</span>
        </h2>
      </div>
      <div class="si-head-right" data-reveal data-reveal-delay="0.08">
        <p class="lede">
          Every engagement starts with the same question: where is the journey losing people,
          and what would prove a fix actually worked? Start with the service that matches yours.
        </p>
        <a class="link-arrow" href="/services/">
          View all services
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
            <path
              d="M1 6h11.5M8.5 1.5 13 6l-4.5 4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </header>

    <ol class="si-grid" data-reveal-group>
      {
        SERVICES.map((s, i) => (
          <li class="si-cell" style={`--i:${i}`}>
            <a
              class="si-card"
              href={s.path}
              style={`--accent:${s.accent}; --soft:${s.accentSoft};`}
              aria-label={`${s.title}: learn more`}
            >
              <span class="si-media">
                <img src={s.art} alt="" loading="lazy" width="880" height="550" />
                <span class="si-veil" aria-hidden="true" />
                <span class="si-fx" aria-hidden="true">
                  <span class="si-scan"></span>
                  <span class="si-bars"><b></b><b></b><b></b></span>
                  <span class="si-ping"></span>
                </span>
                <span class="si-live" aria-hidden="true" data-si-live-wrap data-phrases={JSON.stringify(LIVE[s.slug] ?? ['Live demo'])}>
                  <i></i><span data-si-live>{(LIVE[s.slug] ?? ['Live demo'])[0]}</span>
                </span>
              </span>
              <span class="si-body">
                <span class="si-title">{s.title}</span>
                <span class="si-desc">{s.short}</span>
                <span class="si-cta">
                  Explore service
                  <span class="si-arrow" aria-hidden="true">
                    <svg width="15" height="13" viewBox="0 0 14 12" fill="none">
                      <path
                        d="M1 6h11.5M8.5 1.5 13 6l-4.5 4.5"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </span>
              </span>
              <span class="si-glow" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services-index {
    position: relative;
    background: transparent;
  }

  .si-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .si-head h2 {
    margin-top: 1.1rem;
    max-width: 15ch;
  }

  .si-head-right {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .si-head-right .lede {
    font-size: 1.02rem;
  }

  /* --- Floating mosaic ---------------------------------------------------- */
  .si-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.75rem);
  }

  .si-cell {
    grid-column: span 12;
  }

  @media (min-width: 48rem) {
    .si-cell {
      grid-column: span 6;
    }
    .si-cell:nth-child(1) {
      grid-column: span 7;
    }
    .si-cell:nth-child(2) {
      grid-column: span 5;
    }
    .si-cell:nth-child(6) {
      grid-column: span 5;
    }
    .si-cell:nth-child(7) {
      grid-column: span 7;
    }
  }

  @media (min-width: 75rem) {
    .si-cell:nth-child(3),
    .si-cell:nth-child(4),
    .si-cell:nth-child(5) {
      grid-column: span 4;
    }
    .si-cell:nth-child(3) {
      transform: translateY(1.75rem);
    }
    .si-cell:nth-child(5) {
      transform: translateY(1.75rem);
    }
  }

  .si-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 24px;
    background: rgb(255 255 255 / 0.85);
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    box-shadow: 0 2px 6px rgb(22 22 27 / 0.05), 0 18px 38px -18px rgb(22 22 27 / 0.18);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    isolation: isolate;
    animation: si-float 8.5s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.35s);
    transition: box-shadow 0.5s var(--ease-out), border-color 0.5s var(--ease-out);
  }

  .si-card:hover,
  .si-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow:
      0 4px 10px rgb(22 22 27 / 0.06),
      0 34px 60px -22px color-mix(in srgb, var(--accent) 55%, transparent);
    animation-play-state: paused;
  }

  @keyframes si-float {
    from {
      transform: translateY(-5px) rotate(-0.25deg);
    }
    to {
      transform: translateY(7px) rotate(0.25deg);
    }
  }

  .si-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 8.2;
    overflow: hidden;
    background: var(--soft);
  }

  .si-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.07);
    /* Slow cinematic drift: every card visual stays gently alive. */
    animation: si-kenburns 13s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -2.4s);
  }

  .si-card:hover .si-media img,
  .si-card:focus-visible .si-media img {
    animation-play-state: paused;
  }

  /* Animated visual layer: a slow scan beam, breathing data bars and a
     soft ping, so every card image feels alive like the demos do. */
  .si-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .si-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -14%;
    height: 26%;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 11%, transparent), transparent);
    opacity: 0.52;
    animation: si-scan 7.8s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.9s);
  }

  @keyframes si-scan {
    0%, 100% { transform: translateY(0); opacity: 0; }
    20% { opacity: 0.52; }
    55% { transform: translateY(360%); opacity: 0.42; }
    74%, 99% { opacity: 0; }
  }

  .si-bars {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    padding: 0.5rem 0.55rem;
    background: rgb(19 19 24 / 0.34);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 10px;
    backdrop-filter: blur(3px);
    opacity: 0.78;
  }

  .si-bars b {
    width: 5px;
    border-radius: 3px;
    background: #fff;
    animation: si-bar 2.6s ease-in-out infinite;
  }

  .si-bars b:nth-child(1) { height: 10px; animation-delay: calc(var(--i) * -0.5s); }
  .si-bars b:nth-child(2) { height: 16px; animation-delay: calc(var(--i) * -0.5s - 0.35s); }
  .si-bars b:nth-child(3) { height: 22px; animation-delay: calc(var(--i) * -0.5s - 0.7s); }

  @keyframes si-bar {
    0%, 100% { transform: scaleY(0.55); }
    50% { transform: scaleY(1.15); }
  }

  /* Auto-cycling live status chip: the card quietly narrates its own
     demo, and hovering wakes the whole visual layer up. */
  .si-live {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 6.5rem);
    padding: 0.48rem 0.72rem;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid rgb(255 255 255 / 0.72);
    outline: 1px solid rgb(22 22 27 / 0.08);
    border-radius: 999px;
    box-shadow: 0 14px 28px -16px rgb(22 22 27 / 0.45);
    backdrop-filter: blur(10px) saturate(1.15);
    color: var(--color-ink);
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.025em;
    line-height: 1.2;
    white-space: nowrap;
    animation: si-live-float 5.8s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.75s);
  }

  .si-card:hover .si-live,
  .si-card:focus-visible .si-live {
    animation-play-state: paused;
  }

  @keyframes si-live-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .si-live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    animation: si-ping 2.4s ease-out infinite;
  }

  .si-live [data-si-live] {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .si-live [data-si-live].swap {
    opacity: 0;
    transform: translateY(4px);
  }

  .si-card:hover .si-scan,
  .si-card:focus-visible .si-scan {
    animation-duration: 3.4s;
  }

  .si-card:hover .si-bars b,
  .si-card:focus-visible .si-bars b {
    animation-duration: 1.4s;
  }

  .si-ping {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 34%, transparent);
    opacity: 0.72;
    animation: si-ping 2.8s ease-out infinite;
    animation-delay: calc(var(--i) * -0.7s);
  }

  @keyframes si-ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 34%, transparent); }
    70%, 100% { box-shadow: 0 0 0 9px transparent; }
  }

  @keyframes si-kenburns {
    from {
      transform: scale(1.07) translate(-1.2%, -1%);
    }
    to {
      transform: scale(1.16) translate(1.4%, 1.2%) rotate(0.5deg);
    }
  }

  .si-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 45%, color-mix(in srgb, var(--accent) 26%, transparent)),
      linear-gradient(120deg, color-mix(in srgb, var(--accent) 14%, transparent), transparent 55%);
    mix-blend-mode: multiply;
    opacity: 0.75;
  }

  .si-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.35rem 1.5rem 1.5rem;
    flex: 1;
  }

  .si-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.65rem);
    line-height: 1.12;
    text-wrap: balance;
    transition: color 0.35s var(--ease-out);
  }

  .si-card:hover .si-title {
    color: var(--accent);
  }

  .si-desc {
    font-size: 0.93rem;
    line-height: 1.62;
    color: var(--color-ink-2);
  }

  .si-cta {
    margin-top: auto;
    padding-top: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .si-arrow {
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.9);
    transition: all 0.4s var(--ease-out);
  }

  .si-card:hover .si-arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: translateX(6px) rotate(-8deg);
  }

  .si-glow {
    position: absolute;
    inset: auto -20% -45% -20%;
    height: 60%;
    background: radial-gradient(50% 100% at 50% 100%, var(--soft), transparent 70%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
    z-index: -1;
  }

  .si-card:hover .si-glow {
    opacity: 1;
  }

  @media (max-width: 64rem) {
    .si-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .si-card {
      animation: none;
    }
    .si-media img {
      animation: none;
      transition: none;
    }
    .si-scan, .si-bars b, .si-ping, .si-live, .si-live i {
      animation: none;
    }
  }
</style>

<script>
  // Each card's live chip cycles its own phrases, staggered per card.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-si-live-wrap]').forEach((wrap, cardIndex) => {
      const text = wrap.querySelector<HTMLElement>('[data-si-live]');
      if (!text) return;
      let phrases: string[] = [];
      try {
        phrases = JSON.parse(wrap.dataset.phrases || '[]') as string[];
      } catch {
        phrases = [];
      }
      if (phrases.length < 2) return;
      let i = 0;
      window.setTimeout(() => {
        window.setInterval(() => {
          text.classList.add('swap');
          window.setTimeout(() => {
            i = (i + 1) % phrases.length;
            text.textContent = phrases[i];
            text.classList.remove('swap');
          }, 300);
        }, 2900);
      }, cardIndex * 450);
    });
  }
</script>
