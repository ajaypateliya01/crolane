---
/**
 * Homepage service index: seven editorial rows, each with its own
 * generated artwork, accent hue and link to the detail page.
 */
import { SERVICES } from '../config/services';


---

<section class="section services-index" aria-labelledby="services-title">
  <div class="container-x">
    <header class="si-head">
      <div>
        <p class="eyebrow" data-reveal="fade">Seven focused services</p>
        <h2 class="display-lg" id="services-title" data-reveal>
          Pick the problem. <span class="display-italic">We bring the method.</span>
        </h2>
      </div>
      <div class="si-head-right" data-reveal data-reveal-delay="0.08">
        <p class="lede">
          Each service is its own discipline with its own tools. Together they cover the full
          loop: understand behaviour, improve the journey, automate the busywork.
        </p>
        <a class="link-arrow" href="/services/">
          View all services
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
            <path
              d="M1 6h11.5M8.5 1.5 13 6l-4.5 4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </header>

    <ol class="si-list">
      {
        SERVICES.map((s, i) => (
          <li class="si-row" data-reveal={i % 2 ? 'right' : 'left'} style={`--accent:${s.accent}; --soft:${s.accentSoft};`}>
            <a class="si-link" href={s.path}>
              <span class="si-num">{s.num}</span>
              <span class="si-media">
                <img src={s.art} alt={`Abstract still life illustrating ${s.title}`} loading="lazy" width="640" height="480" />
              </span>
              <span class="si-copy">
                <span class="si-title">{s.title}</span>
                <span class="si-desc">{s.short}</span>
              </span>
              <span class="si-arrow" aria-hidden="true">
                <svg width="18" height="16" viewBox="0 0 14 12" fill="none">
                  <path
                    d="M1 6h11.5M8.5 1.5 13 6l-4.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services-index {
    background: var(--color-paper);
  }

  .si-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .si-head h2 {
    margin-top: 1.1rem;
    max-width: 15ch;
  }

  .si-head-right {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .si-head-right .lede {
    font-size: 1.02rem;
  }

  .si-list {
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .si-row {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    position: relative;
  }

  .si-row::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--soft), transparent 65%);
    opacity: 0;
    transition: opacity 0.45s var(--ease-out);
    pointer-events: none;
  }

  .si-row:hover::after {
    opacity: 0.55;
  }

  .si-link {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 11rem) minmax(0, 1fr) 3rem;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
    padding: clamp(1.1rem, 2.5vw, 1.6rem) 0.5rem;
  }

  .si-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .si-media {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--soft);
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    display: block;
  }

  .si-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }

  .si-row:hover .si-media img {
    transform: scale(1.06);
  }

  .si-copy {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .si-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.95rem);
    line-height: 1.1;
    text-wrap: balance;
    transition: color 0.35s var(--ease-out);
  }

  .si-row:hover .si-title {
    color: var(--accent);
  }

  .si-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 44rem;
  }

  .si-arrow {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    display: grid;
    place-items: center;
    color: var(--color-ink-2);
    justify-self: end;
    transition: all 0.4s var(--ease-out);
    background: rgb(255 255 255 / 0.8);
  }

  .si-row:hover .si-arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: translateX(6px);
  }

  @media (max-width: 64rem) {
    .si-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .si-link {
      grid-template-columns: 2.2rem minmax(0, 8rem) minmax(0, 1fr) 2.6rem;
    }
  }

  @media (max-width: 44rem) {
    .si-link {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.85rem;
      position: relative;
      padding-block: 1.35rem;
    }

    .si-media {
      order: 3;
      max-width: 22rem;
      width: 100%;
    }

    .si-num {
      position: absolute;
      top: 1.35rem;
      left: 0;
    }

    .si-copy {
      padding-left: 2.5rem;
      padding-right: 3.4rem;
    }

    .si-arrow {
      position: absolute;
      top: 1.15rem;
      right: 0;
      width: 2.6rem;
      height: 2.6rem;
    }
  }
</style>
