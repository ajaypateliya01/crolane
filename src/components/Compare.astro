---
// Honest comparison of how CRO help is usually bought. Generic, no named competitors.
const cols = ['Typical agency', 'Audit-only freelancer', 'CROLANE'];
const rows = [
  { k: 'Who does the work', v: ['Account manager, then a team', 'One person', 'The developer you talk to'] },
  { k: 'You get', v: ['Strategy deck + retainer', 'A PDF of findings', 'Findings + fixes shipped live'] },
  { k: 'Price', v: ['Quote after calls, often monthly', 'Low, but no implementation', 'Fixed, published from $599'] },
  { k: 'Speed', v: ['Weeks to start', 'Days for the report', '24 to 48 hours to live fixes'] },
  { k: 'Tracking checked', v: ['Sometimes', 'Rarely', 'Every sprint (GA4 events)'] },
];
---

<section class="section compare" aria-labelledby="compare-title">
  <div class="container-x">
    <div class="cp-head">
      <p class="eyebrow" data-reveal="fade">Why developer-led</p>
      <h2 class="display-md" id="compare-title" data-reveal>
        An audit is only worth something <span class="display-italic cp-hi">once it ships.</span>
      </h2>
    </div>
    <div class="cp-scroll" data-reveal>
      <table class="cp-table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Compare</span></th>
            {cols.map((c, i) => <th scope="col" class:list={{ 'cp-us': i === 2 }}>{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.k}</th>
                {r.v.map((v, i) => <td class:list={{ 'cp-us': i === 2 }}>{v}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="cp-cta" data-reveal>
      <a class="btn btn-primary" href="/bfcm/" data-track="compare_cta">See fixed prices</a>
      <a class="link-arrow" href="/contact/?service=cro-audit" data-track="compare_quote">Or get a custom quote →</a>
    </div>
  </div>
</section>

<style>
  .compare {
    background: var(--color-paper);
  }

  .cp-head {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .cp-hi {
    color: var(--color-indigo);
  }

  .cp-scroll {
    overflow-x: auto;
    border: 1.5px solid var(--color-ink);
    border-radius: 16px;
    background: #fff;
  }

  .cp-table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .cp-table th,
  .cp-table td {
    text-align: left;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }

  .cp-table tbody tr:last-child th,
  .cp-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .cp-table thead th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    font-weight: 500;
  }

  .cp-table tbody th {
    font-weight: 600;
    width: 22%;
  }

  .cp-table td {
    color: var(--color-ink-2);
  }

  .cp-table .cp-us {
    background: color-mix(in srgb, var(--color-signal) 9%, #fff);
    color: var(--color-ink);
    font-weight: 600;
  }

  .cp-table thead .cp-us {
    color: var(--color-indigo);
  }

  .cp-cta {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
  }
</style>
