---
import { serviceBySlug } from '../config/services';

const service = serviceBySlug('conversion-tracking')!;

const stages = [
  { id: 'visit', name: 'Visit', note: 'Arrives on a landing or product page' },
  { id: 'product', name: 'Product view', note: 'Looks at a product in detail' },
  { id: 'cart', name: 'Add to cart', note: 'Commits something to the bag' },
  { id: 'checkout', name: 'Begin checkout', note: 'Starts the payment journey' },
  { id: 'purchase', name: 'Purchase', note: 'Completes the order' },
];
---

<div
  class="tracking-lab"
  data-tracking-lab
  style={`--accent:${service.accent}; --soft:${service.accentSoft};`}
>
  <header class="t-head">
    <div class="t-head-copy">
      <p class="eyebrow eyebrow--accent" data-reveal="fade">Interactive demo · Journey Signal Lab</p>
      <h2 class="display-md" data-reveal>See where the journey loses people</h2>
      <p class="t-lede" data-reveal data-reveal-delay="0.08">
        Tracking earns its keep at the drop-off points. Press Play and a thousand demo visitors
        move through the funnel, so the biggest leak can stand up and introduce itself.
      </p>
    </div>

    <aside class="t-preview" data-reveal="scale" data-reveal-delay="0.1" aria-label="Demo preview">
      <div class="t-preview-top">
        <span>Preview</span>
        <span class="t-ready"><i></i>Funnel mapped</span>
      </div>
      <ul class="t-preview-list" aria-hidden="true">
        {stages.map((s) => <li><span>{s.name}</span><em>no signal yet</em></li>)}
      </ul>
      <p>The stages are mapped. No visitors have flowed through yet.</p>
    </aside>
  </header>

  <div class="t-shell" data-reveal="scale">
    <div class="t-controls">
      <p class="t-status">
        <span class="t-live-dot" aria-hidden="true"></span>
        <span data-tr-status>Ready when you are. Press Play demo to send visitors through.</span>
      </p>
      <button class="btn btn-primary t-play attn" type="button" data-tr-play>
        <span class="t-play-icon" aria-hidden="true"></span>
        <span data-tr-play-label>Play demo</span>
      </button>
    </div>

    <div class="t-grid">
      <div class="t-funnel">
        <p class="t-kicker">Funnel · per 1,000 visitors</p>
        <ol class="t-rows">
          {
            stages.map((s) => (
              <li class="t-row" data-tr-row={s.id}>
                <div class="t-row-head">
                  <b>{s.name}</b>
                  <span class="t-row-nums">
                    <b data-tr-count>0</b>
                    <em data-tr-pct>0%</em>
                  </span>
                </div>
                <div class="t-track" aria-hidden="true"><span data-tr-bar></span></div>
                <p class="t-row-note">
                  {s.note}
                  <span class="t-drop" data-tr-drop hidden></span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="t-insight">
        <p class="t-kicker t-kicker--light">Where it leaks</p>
        <strong data-tr-insight-title>No leak found yet</strong>
        <p data-tr-insight-text>
          The sharpest drop appears here once visitors have flowed through the funnel.
        </p>
        <ol class="t-log" data-tr-log aria-live="polite">
          <li><span>setup</span>Funnel mapped across five stages. Waiting for traffic.</li>
        </ol>
      </div>
    </div>

    <p class="t-note">
      Illustrative demo with fixed, made-up numbers. Real behaviour analysis uses your tracked
      journeys and recordings, and treats every drop as a question, not a verdict.
    </p>
  </div>
</div>

<script>
  import '../scripts/tracking-lab';
</script>

<style>
  .t-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }

  .t-lede {
    margin-top: 1rem;
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .t-preview {
    background: rgb(255 255 255 / 0.85);
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 20px;
    padding: 1.15rem 1.25rem 1.25rem;
    box-shadow: 0 20px 44px -28px rgb(22 22 27 / 0.35);
  }

  .t-preview-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .t-ready {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-emerald);
    letter-spacing: 0.04em;
  }

  .t-ready i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-emerald);
    animation: t-pulse 2.2s ease-in-out infinite;
  }

  @keyframes t-pulse {
    50% { transform: scale(1.35); }
  }

  .t-preview-list {
    list-style: none;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .t-preview-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.78rem;
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-ink) 7%, transparent);
    border-radius: 9px;
    padding: 0.45rem 0.65rem;
  }

  .t-preview-list em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-ink-3);
  }

  .t-preview p {
    margin-top: 0.9rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .t-shell {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 26px;
    box-shadow: var(--shadow-lift);
    padding: clamp(1.1rem, 3vw, 2rem);
    overflow: clip;
  }

  .t-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .t-status {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    line-height: 1.5;
    color: var(--color-ink-2);
    font-size: 0.92rem;
    max-width: 36rem;
  }

  .t-live-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.42rem;
    border-radius: 50%;
    background: var(--color-emerald);
    box-shadow: 0 0 0 0 rgb(23 131 91 / 0.35);
  }

  .tracking-lab[data-state='running'] .t-live-dot {
    animation: t-ping 1.8s ease-out infinite;
  }

  @keyframes t-ping {
    0% { box-shadow: 0 0 0 0 rgb(23 131 91 / 0.35); }
    70%, 100% { box-shadow: 0 0 0 9px transparent; }
  }

  .t-play {
    flex: none;
    min-height: 3.25rem;
    padding-inline: 1.35rem;
  }

  .t-play-icon {
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 9px solid currentColor;
  }

  .t-play.attn {
    animation: t-play-glow 2.1s ease-in-out infinite;
  }

  @keyframes t-play-glow {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 20%, transparent),
        0 18px 34px -16px color-mix(in srgb, var(--accent) 72%, transparent);
    }
  }

  .t-play:disabled {
    cursor: wait;
    opacity: 0.82;
  }

  .t-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1rem, 3vw, 1.6rem);
    align-items: stretch;
  }

  .t-kicker {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  .t-kicker--light {
    color: #ffb59d;
  }

  .t-rows {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .t-row {
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: 14px;
    padding: 0.85rem 1rem;
    transition: border-color 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
  }

  .t-row.is-leak {
    border-color: rgb(217 85 47 / 0.55);
    background: rgb(217 85 47 / 0.05);
  }

  .t-row-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }

  .t-row-head > b {
    font-size: 0.95rem;
  }

  .t-row-nums {
    display: inline-flex;
    gap: 0.6rem;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }

  .t-row-nums b {
    font-size: 1.05rem;
  }

  .t-row-nums em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-3);
  }

  .t-track {
    height: 10px;
    margin-top: 0.6rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .t-track span {
    display: block;
    width: 8%;
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, var(--color-ink) 22%, #fff);
    transition: width 0.2s linear, background-color 0.4s var(--ease-out);
  }

  .tracking-lab[data-state='running'] .t-track span,
  .tracking-lab[data-state='done'] .t-track span {
    background: var(--accent);
  }

  .t-row.is-leak .t-track span {
    background: var(--color-coral);
  }

  .t-row-note {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--color-ink-2);
    line-height: 1.45;
  }

  .t-drop {
    display: inline-block;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--color-coral);
    background: rgb(217 85 47 / 0.12);
    border-radius: 999px;
    padding: 0.18rem 0.5rem;
    animation: t-pop 0.45s var(--ease-out);
  }

  .t-drop[hidden] {
    display: none;
  }

  @keyframes t-pop {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .t-insight {
    background: linear-gradient(165deg, #15151c, #1d1c28 75%);
    color: #fff;
    border-radius: 18px;
    padding: 1.15rem 1.25rem;
    box-shadow: var(--shadow-panel);
    min-width: 0;
  }

  .t-insight strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.15;
  }

  .t-insight > p {
    margin-top: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.8);
  }

  .t-log {
    list-style: none;
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .t-log li {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
    font-size: 0.83rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.78);
    animation: t-log-in 0.45s var(--ease-out);
  }

  .t-log li span {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffb59d;
  }

  @keyframes t-log-in {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: none; }
  }

  .t-note {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }

  @media (max-width: 64rem) {
    .t-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .t-preview {
      max-width: 38rem;
    }
  }

  @media (max-width: 56rem) {
    .t-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .t-shell {
      border-radius: 20px;
      padding: 0.9rem;
    }

    .t-play {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-ready i, .t-live-dot, .t-play.attn, .t-drop, .t-log li {
      animation: none;
    }

    .t-track span, .t-row {
      transition: none;
    }
  }
</style>
