---
const chips = [
  'CRO audits',
  'A/B testing',
  'GA4 & GTM',
  'Behaviour analytics',
  'AI automation',
  'Voice agents',
  'Shopify audits',
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <span class="orb orb-indigo" data-parallax="38"></span>
    <span class="orb orb-amber" data-parallax="-26"></span>
    <span class="orb orb-cool" data-parallax="22"></span>
    <span class="dot-grid"></span>
  </div>

  <div class="container-x hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal="fade">CRO · Experimentation · Measurement · Practical AI</p>
      <h1 class="display-xl" id="hero-title" data-reveal data-reveal-delay="0.06">
        Conversion decisions, backed by <span class="display-italic">evidence</span>.
      </h1>
      <p class="lede" data-reveal data-reveal-delay="0.14">
        We find where customers hesitate, measure what they really do, test the fixes that
        matter, and put practical AI to work where it genuinely saves your team time.
      </p>
      <div class="hero-actions" data-reveal data-reveal-delay="0.22">
        <a class="btn btn-primary" href="/contact/">
          Start a conversation
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
            <path d="M1 6h11.5M8.5 1.5 13 6l-4.5 4.5" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="/services/">Explore services</a>
      </div>
      <ul class="hero-chips" data-reveal data-reveal-delay="0.3" aria-label="Services at a glance">
        {
          chips.map((c) => (
            <li>
              <span class="chip">{c}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-visual" data-reveal="scale" data-reveal-delay="0.18">
      <!-- Static poster: always present, used as fallback without WebGL -->
      <svg class="hero-poster" viewBox="0 0 640 560" aria-hidden="true">
        <defs>
          <linearGradient id="hero-pane" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
            <stop offset="1" stop-color="#eef1f7" stop-opacity="0.65"></stop>
          </linearGradient>
        </defs>
        <g stroke-linecap="round">
          <path
            d="M60 430 C 160 430 200 330 300 300 C 380 276 400 250 470 210"
            stroke="#3e4ef5"
            stroke-opacity="0.4"
            stroke-width="3"
            fill="none"></path>
          <path
            d="M470 210 C 520 184 540 150 560 110"
            stroke="#3e4ef5"
            stroke-opacity="0.7"
            stroke-width="3"
            fill="none"></path>
          <path
            d="M470 210 C 510 240 530 300 545 360"
            stroke="#c77415"
            stroke-opacity="0.55"
            stroke-width="3"
            fill="none"></path>
        </g>
        <g>
          <rect x="70" y="330" width="130" height="90" rx="10" fill="url(#hero-pane)" stroke="#16161b" stroke-opacity="0.14"></rect>
          <rect x="180" y="262" width="130" height="90" rx="10" fill="url(#hero-pane)" stroke="#16161b" stroke-opacity="0.14"></rect>
          <rect x="290" y="208" width="130" height="90" rx="10" fill="url(#hero-pane)" stroke="#16161b" stroke-opacity="0.14"></rect>
          <rect x="400" y="152" width="130" height="90" rx="10" fill="url(#hero-pane)" stroke="#16161b" stroke-opacity="0.14"></rect>
        </g>
        <circle cx="470" cy="210" r="7" fill="#16161b" fill-opacity="0.5"></circle>
        <circle cx="560" cy="110" r="10" fill="#3e4ef5"></circle>
        <circle cx="230" cy="300" r="6" fill="#c77415"></circle>
      </svg>
      <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
      <div class="hero-chip chip-a anim-float" aria-hidden="true">
        <span class="hc-dot hc-indigo"></span>
        A/B test in progress · demo
      </div>
      <div class="hero-chip chip-b anim-float-late" aria-hidden="true">
        <span class="hc-dot hc-emerald"></span>
        Enquiry captured · demo
      </div>
      <div class="hero-visual-caption" aria-hidden="true">
        <span class="cap-dot"></span>
        Live scene: visitor journeys splitting at an experiment gate
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-line"></span>
    <span class="micro">Scroll</span>
  </div>
</section>

<script>
  import { initHeroScene } from '../scripts/hero-scene';

  const boot = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-canvas]').forEach((canvas) => {
      const container = canvas.closest<HTMLElement>('.hero-visual');
      if (container) initHeroScene(container, canvas);
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 60rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: clamp(3.5rem, 8vh, 6rem);
    overflow: clip;
    background: var(--color-paper);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
  }

  .orb-indigo {
    width: 34rem;
    height: 34rem;
    right: -8rem;
    top: -6rem;
    background: radial-gradient(circle, rgb(62 78 245 / 0.16), transparent 65%);
  }

  .orb-amber {
    width: 26rem;
    height: 26rem;
    right: 12%;
    bottom: -8rem;
    background: radial-gradient(circle, rgb(199 116 21 / 0.14), transparent 65%);
  }

  .orb-cool {
    width: 30rem;
    height: 30rem;
    left: -12rem;
    bottom: 6rem;
    background: radial-gradient(circle, rgb(37 99 217 / 0.08), transparent 65%);
  }

  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 11%, transparent) 1px, transparent 1.2px);
    background-size: 34px 34px;
    mask-image: radial-gradient(75% 65% at 60% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(75% 65% at 60% 40%, #000 20%, transparent 75%);
    opacity: 0.55;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 38rem;
  }

  .hero-copy .display-xl {
    max-width: 13ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 0.4rem;
  }

  .hero-visual {
    position: relative;
    min-height: clamp(24rem, 46vw, 34rem);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 70% 20%, rgb(255 255 255 / 0.9), transparent 60%),
      linear-gradient(160deg, rgb(238 241 247 / 0.8), rgb(244 241 234 / 0.7));
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .hero-poster {
    position: absolute;
    inset: 6% 4%;
    width: 92%;
    height: 88%;
    opacity: 0.9;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-visual[data-webgl='failed'] .hero-canvas {
    display: none;
  }

  .hero-visual-caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
  }

  .cap-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-emerald);
    box-shadow: 0 0 0 3px rgb(23 131 91 / 0.18);
    animation: cap-pulse 2.4s ease-in-out infinite;
  }

  @keyframes cap-pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(23 131 91 / 0.08);
    }
  }

  .hero-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.78);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    box-shadow: 0 14px 30px -14px rgb(22 22 27 / 0.35);
    z-index: 3;
  }

  .chip-a {
    top: 1.1rem;
    right: 1.1rem;
  }

  .chip-b {
    right: 1.4rem;
    bottom: 4.2rem;
  }

  .hc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }

  .hc-indigo {
    background: var(--color-indigo);
    box-shadow: 0 0 0 3px rgb(62 78 245 / 0.18);
  }

  .hc-emerald {
    background: var(--color-emerald);
    box-shadow: 0 0 0 3px rgb(23 131 91 / 0.18);
  }

  .hero-scroll {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
    padding-inline: var(--gutter);
    max-width: 80rem;
    margin-inline: auto;
    width: 100%;
    color: var(--color-ink-3);
  }

  .scroll-line {
    width: 3.5rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-ink) 25%, transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-indigo);
    transform: translateX(-100%);
    animation: scroll-sweep 2.2s var(--ease-out) infinite;
  }

  @keyframes scroll-sweep {
    55%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 60rem) {
    .hero {
      min-height: 0;
      padding-top: 7.5rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      min-height: clamp(19rem, 62vw, 26rem);
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after,
    .cap-dot {
      animation: none;
    }
  }
</style>
