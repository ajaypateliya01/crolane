---
const chips = [
  'CRO audits',
  'A/B testing',
  'GA4 & GTM',
  'Behaviour analytics',
  'AI automation',
  'Voice agents',
  'Shopify audits',
];

const bars = [42, 58, 47, 66, 54, 72, 61, 78, 69, 84, 76, 92];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <span class="orb orb-indigo" data-parallax="38"></span>
    <span class="orb orb-amber" data-parallax="-26"></span>
    <span class="orb orb-cool" data-parallax="22"></span>
    <span class="dot-grid"></span>
  </div>

  <div class="container-x hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal="fade">CRO · Experimentation · Measurement · Practical AI</p>
      <h1 class="display-xl" id="hero-title" data-reveal data-reveal-delay="0.06">
        Turn more visitors into <span class="display-italic grad-word">customers</span>, with proof
        at every step.
      </h1>
      <p class="lede" data-reveal data-reveal-delay="0.14">
        We find where your customer journey leaks revenue, measure what people really do, test the
        fixes that matter, and automate the repetitive work around it all.
      </p>
      <div class="hero-actions" data-reveal data-reveal-delay="0.22">
        <a class="btn btn-primary" href="/contact/">
          Start a conversation
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
            <path d="M1 6h11.5M8.5 1.5 13 6l-4.5 4.5" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="/services/">Explore services</a>
      </div>
      <ul class="hero-chips" data-reveal data-reveal-delay="0.3" aria-label="Services at a glance">
        {
          chips.map((c) => (
            <li>
              <span class="chip">{c}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="dash-wrap" data-reveal="scale" data-reveal-delay="0.18">
      <div class="dash" data-hero-dash data-tilt="5">
        <div class="dash-top">
          <span class="dash-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="dash-title">Store performance</span>
          <span class="live-badge"><span class="live-dot"></span>Live</span>
          <span class="demo-tag">Illustrative demo</span>
        </div>

        <div class="kpis">
          <div class="kpi">
            <span class="kpi-label">Purchases</span>
            <span class="kpi-value" data-kpi="purchases">1,284</span>
            <span class="kpi-sub up">▲ today</span>
          </div>
          <div class="kpi">
            <span class="kpi-label">Add to cart</span>
            <span class="kpi-value" data-kpi="carts">3,912</span>
            <span class="kpi-sub up">▲ today</span>
          </div>
          <div class="kpi">
            <span class="kpi-label">Conversion rate</span>
            <span class="kpi-value" data-kpi="rate">3.42%</span>
            <span class="kpi-sub">rolling</span>
          </div>
        </div>

        <div class="rev-row">
          <div>
            <span class="kpi-label">Revenue today</span>
            <span class="rev-value">$<span data-kpi="revenue">184,520</span></span>
          </div>
          <span class="delta-chip">+12.4% vs yesterday · demo</span>
        </div>

        <div class="chart-box">
          <svg class="chart" viewBox="0 0 560 190" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="dash-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#3e4ef5" stop-opacity="0.28"></stop>
                <stop offset="1" stop-color="#3e4ef5" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <g class="grid-lines" stroke="#16161b" stroke-opacity="0.06">
              <line x1="0" y1="47" x2="560" y2="47"></line>
              <line x1="0" y1="95" x2="560" y2="95"></line>
              <line x1="0" y1="142" x2="560" y2="142"></line>
            </g>
            <path data-chart-area fill="url(#dash-fill)"></path>
            <path data-chart-a fill="none" stroke="#3e4ef5" stroke-width="2.6" stroke-linecap="round"></path>
            <path
              data-chart-b
              fill="none"
              stroke="#c77415"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-dasharray="1 7"
              stroke-linejoin="round"></path>
            <circle data-chart-dot r="4.5" fill="#3e4ef5" stroke="#fff" stroke-width="2"></circle>
          </svg>
          <div class="chart-legend" aria-hidden="true">
            <span><i class="lg lg-a"></i>Variant A</span>
            <span><i class="lg lg-b"></i>Variant B · test</span>
            <span class="vis-now"><i class="ev ev-e"></i><b data-kpi="visitors">312</b>&nbsp;visitors now</span>
          </div>
          <div class="donut" aria-hidden="true">
            <svg viewBox="0 0 44 44">
              <circle class="donut-bg" cx="22" cy="22" r="17"></circle>
              <circle class="donut-val" cx="22" cy="22" r="17"></circle>
            </svg>
            <span>B</span>
          </div>
        </div>

        <div class="dash-bottom">
          <div class="bars" data-bars aria-hidden="true">
            {bars.map((h) => <span style={`height:${h}%`}></span>)}
          </div>
          <ul class="events">
            <li><i class="ev ev-i"></i>purchase<b data-evt="purchases">1,284</b></li>
            <li><i class="ev ev-a"></i>add_to_cart<b data-evt="carts">3,912</b></li>
            <li><i class="ev ev-e"></i>begin_checkout<b data-evt="checkout">986</b></li>
          </ul>
        </div>
      </div>

      <div class="hero-chip chip-a anim-float" aria-hidden="true">
        <span class="hc-dot hc-indigo"></span>
        A/B test in progress · demo
      </div>
      <div class="hero-chip chip-b anim-float-late" aria-hidden="true">
        <span class="hc-dot hc-emerald"></span>
        <span data-toast>Purchase · $120 · just now</span>
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-line"></span>
    <span class="micro">Scroll</span>
  </div>
</section>

<script>
  import { initHeroDash } from '../scripts/hero-dash';

  const boot = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-dash]').forEach((el) => initHeroDash(el));
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(6.4rem, 11vh, 8rem);
    padding-bottom: clamp(2.2rem, 5vh, 3.5rem);
    overflow: clip;
    background: var(--color-paper);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
  }

  .orb-indigo {
    width: 34rem;
    height: 34rem;
    right: -8rem;
    top: -6rem;
    background: radial-gradient(circle, rgb(62 78 245 / 0.18), transparent 65%);
  }

  .orb-amber {
    width: 26rem;
    height: 26rem;
    right: 12%;
    bottom: -8rem;
    background: radial-gradient(circle, rgb(199 116 21 / 0.16), transparent 65%);
  }

  .orb-cool {
    width: 30rem;
    height: 30rem;
    left: -12rem;
    bottom: 6rem;
    background: radial-gradient(circle, rgb(37 99 217 / 0.1), transparent 65%);
  }

  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 11%, transparent) 1px, transparent 1.2px);
    background-size: 34px 34px;
    mask-image: radial-gradient(75% 65% at 60% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(75% 65% at 60% 40%, #000 20%, transparent 75%);
    opacity: 0.55;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
    max-width: 38rem;
  }

  .hero-copy .display-xl {
    max-width: 14ch;
    font-size: clamp(2.5rem, 4.6vw, 3.9rem);
  }

  .grad-word {
    background: linear-gradient(100deg, var(--color-indigo), var(--color-violet, #7c4dff), var(--color-amber), var(--color-indigo));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: grad-pan 7s ease-in-out infinite alternate;
  }

  @keyframes grad-pan {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 0.2rem;
  }

  /* --- Live analytics dashboard ------------------------------------------ */
  .dash-wrap {
    position: relative;
  }

  .dash {
    position: relative;
    border-radius: 26px;
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    box-shadow:
      0 2px 6px rgb(22 22 27 / 0.05),
      0 40px 80px -32px rgb(62 78 245 / 0.35),
      0 24px 48px -24px rgb(22 22 27 / 0.22);
    padding: 1.15rem 1.25rem 1.25rem;
    overflow: hidden;
  }

  .dash::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-indigo), var(--color-violet, #7c4dff), var(--color-amber), var(--color-indigo));
    background-size: 200% 100%;
    animation: grad-pan 6s linear infinite alternate;
  }

  .dash-top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }

  .dash-dots {
    display: inline-flex;
    gap: 5px;
  }

  .dash-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .dash-dots i:first-child { background: var(--color-coral, #d9552f); opacity: 0.75; }
  .dash-dots i:nth-child(2) { background: var(--color-amber); opacity: 0.85; }
  .dash-dots i:last-child { background: var(--color-emerald); opacity: 0.85; }

  .dash-title {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--color-emerald);
    background: rgb(23 131 91 / 0.1);
    border: 1px solid rgb(23 131 91 / 0.25);
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-emerald);
    animation: cap-pulse 1.6s ease-in-out infinite;
  }

  .demo-tag {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    border: 1px dashed color-mix(in srgb, var(--color-ink) 25%, transparent);
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  .kpi {
    background: linear-gradient(160deg, #fff, var(--color-paper-3, #eef1f7));
    border: 1px solid color-mix(in srgb, var(--color-ink) 7%, transparent);
    border-radius: 16px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .kpi-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .kpi-value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.05;
    display: inline-block;
  }

  .kpi-value.tick {
    animation: kpi-pop 0.5s var(--ease-out);
  }

  @keyframes kpi-pop {
    30% { transform: translateY(-3px) scale(1.06); color: var(--color-indigo); }
  }

  .kpi-sub {
    font-size: 0.66rem;
    color: var(--color-ink-3);
  }

  .kpi-sub.up { color: var(--color-emerald); }

  .rev-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0.1rem 0.85rem;
  }

  .rev-row > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .rev-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1;
  }

  .delta-chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--color-emerald);
    background: rgb(23 131 91 / 0.09);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
  }

  .dash::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.35) 50%, transparent 65%);
    transform: translateX(-130%);
    animation: dash-shine 5.5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes dash-shine {
    0%, 55% { transform: translateX(-130%); }
    85%, 100% { transform: translateX(130%); }
  }

  .vis-now {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .vis-now b { color: var(--color-ink); }

  .donut {
    position: absolute;
    top: 0.55rem;
    right: 0.6rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
  }

  .donut svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }

  .donut circle {
    fill: none;
    stroke-width: 5;
  }

  .donut-bg { stroke: color-mix(in srgb, var(--color-ink) 9%, transparent); }

  .donut-val {
    stroke: var(--color-amber);
    stroke-linecap: round;
    stroke-dasharray: 72 107;
    animation: donut-spin 7s linear infinite;
    transform-origin: center;
  }

  @keyframes donut-spin {
    to { transform: rotate(360deg); }
  }

  .donut span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--color-amber);
  }

  .chart-box {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-ink) 7%, transparent);
    border-radius: 16px;
    background: linear-gradient(180deg, #fff, rgb(238 241 247 / 0.5));
    padding: 0.6rem 0.6rem 0.3rem;
  }

  .chart {
    width: 100%;
    height: 150px;
    display: block;
  }

  .chart-legend {
    display: flex;
    gap: 1.1rem;
    padding: 0.3rem 0.2rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .lg {
    display: inline-block;
    width: 14px;
    height: 3px;
    border-radius: 2px;
    margin-right: 0.4rem;
    vertical-align: middle;
  }

  .lg-a { background: var(--color-indigo); }
  .lg-b { background: var(--color-amber); }

  .dash-bottom {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 1rem;
    align-items: end;
    margin-top: 0.9rem;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 52px;
  }

  .bars span {
    flex: 1;
    min-height: 12%;
    border-radius: 4px 4px 2px 2px;
    background: linear-gradient(180deg, var(--color-indigo), var(--color-azure, #2563d9));
    opacity: 0.85;
    transition: height 0.9s var(--ease-out);
  }

  .bars span:nth-child(3n) {
    background: linear-gradient(180deg, var(--color-amber), var(--color-coral, #d9552f));
  }

  .events {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-ink-2);
  }

  .events li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .events b {
    margin-left: auto;
    color: var(--color-ink);
    font-weight: 600;
  }

  .ev {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }

  .ev-i { background: var(--color-indigo); }
  .ev-a { background: var(--color-amber); }
  .ev-e { background: var(--color-emerald); }

  /* Floating chips over the dashboard */
  .hero-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    box-shadow: 0 14px 30px -14px rgb(22 22 27 / 0.35);
    z-index: 3;
  }

  .chip-a { top: -0.9rem; right: 1.2rem; }
  .chip-b { left: -0.6rem; bottom: 2.2rem; }

  .hc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }

  .hc-indigo { background: var(--color-indigo); box-shadow: 0 0 0 3px rgb(62 78 245 / 0.18); }
  .hc-emerald { background: var(--color-emerald); box-shadow: 0 0 0 3px rgb(23 131 91 / 0.18); }

  @keyframes cap-pulse {
    50% { box-shadow: 0 0 0 6px rgb(23 131 91 / 0.1); }
  }

  .hero-scroll {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(1.6rem, 4vh, 2.6rem);
    padding-inline: var(--gutter);
    max-width: 80rem;
    margin-inline: auto;
    width: 100%;
    color: var(--color-ink-3);
  }

  .scroll-line {
    width: 3.5rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-ink) 25%, transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-indigo);
    transform: translateX(-100%);
    animation: scroll-sweep 2.2s var(--ease-out) infinite;
  }

  @keyframes scroll-sweep {
    55%, 100% { transform: translateX(100%); }
  }

  @media (max-width: 60rem) {
    .hero {
      padding-top: 6rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .chip-b {
      left: 0.4rem;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .kpis {
      grid-template-columns: 1fr 1fr;
    }
    .kpi:last-child {
      grid-column: span 2;
    }
    .dash-bottom {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after,
    .dash::after,
    .donut-val,
    .live-dot,
    .grad-word,
    .dash::before {
      animation: none;
    }
    .bars span {
      transition: none;
    }
  }
</style>
