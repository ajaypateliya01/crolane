---
interface Props {
  eyebrow?: string;
  title?: string;
  highlight?: string;
}
const {
  eyebrow = 'Where stores lose sales',
  title = 'Most stores do not need more traffic.',
  highlight = 'They leak the traffic they have.',
} = Astro.props;

const leaks = [
  { n: '01', t: 'Add to cart is buried', d: 'On mobile the button sits below two screens of images and text, so shoppers scroll past it.' },
  { n: '02', t: 'The offer is invisible', d: 'The discount lives on the homepage banner and disappears on the product page where people decide.' },
  { n: '03', t: 'Costs show up too late', d: 'Shipping and delivery dates appear only at checkout, which is where carts get abandoned.' },
  { n: '04', t: 'Tracking is broken', d: 'Purchase events fire twice or not at all, so nobody can tell which change actually worked.' },
];
---

<section class="section-sm leaks" aria-labelledby="leaks-title">
  <div class="container-x">
    <div class="lk-head">
      <p class="eyebrow" data-reveal="fade">{eyebrow}</p>
      <h2 class="display-md" id="leaks-title" data-reveal>
        {title} <span class="display-italic lk-hi">{highlight}</span>
      </h2>
    </div>
    <ol class="lk-grid" data-reveal-group>
      {
        leaks.map((l) => (
          <li class="lk-item">
            <span class="lk-n">{l.n}</span>
            <h3>{l.t}</h3>
            <p>{l.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .leaks {
    background: #fff;
    border-bottom: 1px solid var(--color-line);
  }

  .lk-head {
    max-width: 46rem;
    margin-bottom: 2.2rem;
  }

  .lk-hi {
    color: var(--color-indigo);
  }

  .lk-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1.5px solid var(--color-ink);
  }

  .lk-item {
    padding: 1.4rem 1.4rem 0.4rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lk-item + .lk-item {
    padding-left: 1.4rem;
    border-left: 1px solid var(--color-line);
  }

  .lk-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-indigo);
  }

  .lk-item h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .lk-item p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  @media (max-width: 60rem) {
    .lk-grid {
      grid-template-columns: 1fr 1fr;
    }

    .lk-item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 36rem) {
    .lk-grid {
      grid-template-columns: 1fr;
    }

    .lk-item + .lk-item {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }
</style>
