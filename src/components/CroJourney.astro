---
/**
 * CRO audit walkthrough: a customer journey rail that gains friction
 * annotations as the section scrolls, resolving into a prioritised
 * audit table. No pinning; scrubbed directly off scroll position.
 */
const stations = [
  { id: 'landing', label: 'Landing' },
  { id: 'product', label: 'Product' },
  { id: 'cart', label: 'Cart' },
  { id: 'checkout', label: 'Checkout' },
  { id: 'confirmed', label: 'Confirmed' },
];

const notes = [
  {
    at: 0.18,
    station: 'Landing',
    title: 'Message match',
    body: 'Ad promise and first screen disagree on the offer. Visitors arriving on the paid campaign see a different headline than the ad they clicked (fictional example).',
  },
  {
    at: 0.45,
    station: 'Product',
    title: 'Decision details',
    body: 'Fit, delivery timing and returns sit below the fold while the primary action waits underneath them. The information people need to click is separated from the click.',
  },
  {
    at: 0.72,
    station: 'Checkout',
    title: 'Guest path',
    body: 'Account creation appears before guest checkout, and two optional fields interrupt a short form. A common, measurable drop-off pattern (fictional example).',
  },
];

const priorities = [
  { p: 'P0', issue: 'Move delivery and returns above the primary action on product pages', impact: 3, effort: 1 },
  { p: 'P0', issue: 'Restore guest checkout as the default path', impact: 3, effort: 2 },
  { p: 'P1', issue: 'Align paid campaign headlines with the landing experience', impact: 2, effort: 1 },
  { p: 'P2', issue: 'Clarify bundle savings in the variant selector', impact: 2, effort: 2 },
];
---

<section
  class="section cro-journey tone-cool"
  aria-labelledby="cro-journey-title"
  data-cro-journey
  style="--accent: var(--color-amber);"
>
  <div class="container-x">
    <header class="cj-head">
      <div>
        <p class="eyebrow eyebrow--accent" data-reveal="fade">CRO audit · live demonstration</p>
        <h2 class="display-lg" id="cro-journey-title" data-reveal>
          Watch friction <span class="display-italic">surface</span>.
        </h2>
      </div>
      <p class="lede" data-reveal data-reveal-delay="0.08">
        An audit walks the journey the way a visitor does, then marks the moments that create
        doubt. Scroll to move through the demo journey and see the annotations build.
      </p>
    </header>

    <div class="viz-stage cj-stage" data-reveal="scale">
      <div class="viz-chrome">
        <div class="viz-chrome-left">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="viz-url">audit.demo / sample journey / desktop + mobile review</span>
        </div>
        <span class="viz-note">Fictional interface example</span>
      </div>

      <div class="cj-body">
        <!-- Journey rail -->
        <div class="cj-rail-wrap">
          <div class="cj-rail" data-cj-rail>
            <div class="cj-track" aria-hidden="true"><span class="cj-progress" data-cj-progress></span></div>
            <ol class="cj-stations">
              {
                stations.map((s) => (
                  <li data-cj-station={s.id}>
                    <span class="cj-dot" aria-hidden="true" />
                    <span class="cj-label">{s.label}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <!-- Annotation cards -->
          <div class="cj-notes">
            {
              notes.map((n) => (
                <article class="cj-note" data-cj-note data-at={n.at}>
                  <p class="cj-note-station">{n.station}</p>
                  <h3>{n.title}</h3>
                  <p>{n.body}</p>
                </article>
              ))
            }
          </div>

          <!-- Priorities -->
          <div class="cj-priorities" data-cj-priorities>
            <div class="cj-pri-head">
              <p class="label-mono">Audit output (illustrative)</p>
              <p class="cj-pri-sub">Priorities ranked by estimated impact and effort</p>
            </div>
            <ul>
              {
                priorities.map((row) => (
                  <li>
                    <span class="pri-tag">{row.p}</span>
                    <span class="pri-issue">{row.issue}</span>
                    <span class="pri-dots" aria-label={`Impact ${row.impact} of 3, effort ${row.effort} of 3`}>
                      <span class="dotset" aria-hidden="true">
                        {[1, 2, 3].map((d) => <i class={d <= row.impact ? 'on' : ''} />)}
                      </span>
                      <span class="dotset effort" aria-hidden="true">
                        {[1, 2, 3].map((d) => <i class={d <= row.effort ? 'on' : ''} />)}
                      </span>
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="cj-legend">
              <span><i class="lg-impact" />Impact</span>
              <span><i class="lg-effort" />Effort</span>
              · illustrative priorities, not results from a client audit
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/cro-journey';
</script>

<style>
  .cro-journey {
    background:
      radial-gradient(75% 50% at 90% 10%, rgb(199 116 21 / 0.07), transparent 60%),
      var(--color-paper-3);
    overflow: clip;
  }

  .cj-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .cj-head h2 {
    margin-top: 1.1rem;
    max-width: 14ch;
  }

  .cj-body {
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .cj-rail-wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 16px;
    padding: clamp(1.2rem, 3vw, 2rem);
    box-shadow: var(--shadow-soft);
  }

  /* Rail */
  .cj-rail {
    position: relative;
    padding-top: 0.5rem;
  }

  .cj-track {
    position: absolute;
    left: 4%;
    right: 4%;
    top: calc(0.5rem + 9px);
    height: 3px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }

  .cj-progress {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, var(--color-amber), var(--color-indigo));
  }

  .cj-stations {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    position: relative;
  }

  .cj-stations li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-ink-3);
    transition: color 0.4s var(--ease-out);
    text-align: center;
  }

  .cj-dot {
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: #fff;
    border: 3.5px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    transition: all 0.4s var(--ease-out);
  }

  .cj-stations li.lit {
    color: var(--color-ink);
    font-weight: 580;
  }

  .cj-stations li.lit .cj-dot {
    border-color: var(--color-amber);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-amber) 16%, transparent);
  }

  .cj-stations li.flagged .cj-dot {
    border-color: var(--color-coral);
    background: var(--color-coral);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-coral) 16%, transparent);
  }

  /* Notes */
  .cj-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .cj-note {
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 14px;
    padding: 1rem 1.05rem;
    background: var(--color-paper);
    opacity: 0.25;
    transform: translateY(14px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out),
      border-color 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }

  .cj-note.lit {
    opacity: 1;
    transform: none;
    border-color: color-mix(in srgb, var(--color-amber) 45%, transparent);
    box-shadow: 0 12px 28px -18px rgb(199 116 21 / 0.55);
  }

  .cj-note-station {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: 0.45rem;
  }

  .cj-note h3 {
    font-size: 1rem;
    font-weight: 610;
    margin-bottom: 0.4rem;
  }

  .cj-note p:last-child {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  /* Priorities */
  .cj-priorities {
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 16%, transparent);
    padding-top: clamp(1.1rem, 2.5vw, 1.5rem);
    opacity: 0.3;
    transform: translateY(14px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }

  .cj-priorities.lit {
    opacity: 1;
    transform: none;
  }

  .cj-pri-sub {
    font-size: 0.8rem;
    color: var(--color-ink-3);
    margin-top: 0.2rem;
  }

  .cj-priorities ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.9rem;
  }

  .cj-priorities li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 12px;
    background: #fff;
    font-size: 0.87rem;
  }

  .pri-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-ink);
    border-radius: 6px;
    padding: 0.22rem 0.4rem;
    text-align: center;
  }

  .cj-priorities li:first-child .pri-tag {
    background: var(--color-coral);
  }

  .pri-issue {
    color: var(--color-ink-2);
  }

  .pri-dots {
    display: flex;
    gap: 0.8rem;
  }

  .dotset {
    display: inline-flex;
    gap: 3px;
  }

  .dotset i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .dotset i.on {
    background: var(--color-indigo);
  }

  .dotset.effort i.on {
    background: var(--color-amber);
  }

  .cj-legend {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.85rem;
    font-size: 0.72rem;
    color: var(--color-ink-3);
  }

  .cj-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cj-legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .lg-impact {
    background: var(--color-indigo);
  }

  .lg-effort {
    background: var(--color-amber);
  }

  @media (max-width: 64rem) {
    .cj-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .cj-notes {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .cj-stations li {
      font-size: 0.68rem;
    }

    .cj-priorities li {
      grid-template-columns: 2.6rem minmax(0, 1fr);
      row-gap: 0.5rem;
    }

    .pri-dots {
      grid-column: 2;
    }
  }
</style>
