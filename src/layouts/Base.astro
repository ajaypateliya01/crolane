---
import '../styles/global.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { SERVICES } from '../config/services';
import StickyCta from '../components/StickyCta.astro';
import siteSettings from '../content/settings/site.json';

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION as string | undefined;
// GTM container. Env var wins; fallback keeps tracking on even if Hostinger env is not set.
const gtmId = (import.meta.env.PUBLIC_GTM_ID as string | undefined)?.trim() || 'GTM-NF276TGW';
const ga4Id = (import.meta.env.PUBLIC_GA4_ID as string | undefined)?.trim() || 'G-P6SX0BK17M';
const hotjarId = Number(import.meta.env.PUBLIC_HOTJAR_ID) || 6856108;
const hasOffer = siteSettings.offerBar.enabled;

interface Props {
  title: string;
  description: string;
  /** Pathname or absolute URL for this page's canonical/OG URL. Defaults to current path. */
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  /** Extra JSON-LD blocks for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Extra class on <body>, e.g. 'dark-top' for pages with a dark hero. */
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/og-default.png',
  ogType = 'website',
  jsonLd = [],
  bodyClass,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, SITE.url);
const ogImageURL = new URL(ogImage, SITE.url);

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  email: SITE.email,
  description: SITE.description,
  logo: `${SITE.url}/images/og-default.png`,
  knowsAbout: SERVICES.map((service) => service.title),
  founder: {
    '@type': 'Person',
    name: siteSettings.founder.name,
    jobTitle: siteSettings.founder.role,
    sameAs: [siteSettings.founder.linkedin],
  },
  sameAs: [siteSettings.founder.linkedin],
  areaServed: ['US', 'GB', 'AU', 'CA', 'IN'],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: 'en',
};

const ldBlocks = [organizationLd, websiteLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
          <script is:inline define:vars={{ ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { dataLayer.push(arguments); };
            gtag('js', new Date());
            gtag('config', ga4Id);
          </script>
        </>
      )
    }
    {
      hotjarId > 0 && (
        <script is:inline define:vars={{ hotjarId }}>
          (function(h,o,t,j,a,r){h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};h._hjSettings={hjid:hotjarId,hjsv:6};a=o.getElementsByTagName('head')[0];r=o.createElement('script');r.async=1;r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;a.appendChild(r);})(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfaf7" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    {
      ldBlocks.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify(ldBlocks)} />
      )
    }

    <script is:inline>
      // Mark JS availability early so reveal styles never hide content
      // when scripts fail to load, and keep reduced-motion users untouched.
      document.documentElement.classList.add('js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduced-motion');
      }
    </script>
  </head>
  <body class:list={[{ 'has-offer': hasOffer }, bodyClass]}>
    {
      gtmId && (
        <noscript>
          <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" />
        </noscript>
      )
    }
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="ambient" aria-hidden="true"><span class="amb-a"></span><span class="amb-b"></span></div>
    <div class="cursor-glow" aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
