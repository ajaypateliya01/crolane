---
export const prerender = true;

import Base from '../layouts/Base.astro';
import NightHero from '../components/ui/NightHero.astro';
import Demo from '../components/ui/Demo.astro';
import Faq from '../components/ui/Faq.astro';
import CtaNight from '../components/ui/CtaNight.astro';
import { UA, TICK } from '../components/ui/Icons';
import bfcm from '../content/settings/bfcm.json';
import { SITE } from '../config/site';

// After the sale, old links and outreach emails land on the pricing page.
if (!bfcm.enabled) return Astro.redirect('/pricing/', 301);

const from = Math.min(...bfcm.packages.map((p) => p.price));
const title = `Black Friday Shopify CRO Sprints from $${from} | CROLANE`;
const description = `Fixed-price Shopify conversion sprints: audit plus done-for-you fixes on product page, cart and mobile, live before Cyber Monday. From $${from}.`;

const leaks = [
  'Add to cart buried below two screens of images on mobile',
  'The BFCM discount shows on the homepage but not on product pages',
  'Shipping cost and delivery dates appear only at checkout',
  'Purchase events fire twice or not at all, so nothing is measurable',
];
const steps = [
  ['Claim a package', 'Pick a package and send your store URL. You get a reply and invoice, usually within a couple of hours.'],
  ['Share collaborator access', 'No passwords. Work happens on a duplicate theme, never your live one.'],
  ['Approve and go live', 'You preview every fix, then it is published. Done in 24 to 48 hours.'],
];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Shopify Black Friday Cyber Monday conversion sprint',
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: ['US', 'GB', 'AU', 'CA'],
    offers: bfcm.packages.map((p) => ({ '@type': 'Offer', name: p.name, price: p.price, priceCurrency: 'USD', description: p.summary, url: `${SITE.url}/bfcm/#packages`, availability: 'https://schema.org/LimitedAvailability' })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: bfcm.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={title} description={description} canonicalPath="/bfcm/" jsonLd={ld}>
  <NightHero>
    <div>
      <p class="kicker" style="margin-bottom:18px;color:var(--lav)">{bfcm.eyebrow}</p>
      <h1 class="h1 sm">{bfcm.headline}</h1>
      <p class="lede" style="margin-top:22px">{bfcm.lede}</p>
      <div class="count" data-countdown={bfcm.deadline} aria-label="Offer ends in">
        <div><b data-c="d">00</b><small>Days</small></div><div><b data-c="h">00</b><small>Hours</small></div><div><b data-c="m">00</b><small>Min</small></div><div><b data-c="s">00</b><small>Sec</small></div>
      </div>
      <p class="slots"><span class="pulse" style="background:var(--lav)"></span>{bfcm.slots} store slots only. {bfcm.deadlineLabel}</p>
      <div class="actions"><a class="btn btn-white" href="#packages" data-track="bfcm_hero">See the packages <Fragment set:html={UA} /></a></div>
    </div>
    <Demo kind="funnel" dark />
  </NightHero>

  <section id="packages">
    <div class="wrap">
      <div class="sec-title"><p class="kicker c rv">Packages</p><h2 class="h2 rv" style="margin-top:14px">Pick your <span class="it">sprint</span></h2><p class="rv">Prices locked until the timer ends.</p></div>
      <div class="pk-grid">
        {bfcm.packages.map((p) => (
          <div class:list={['pk rv', { pop: p.highlight }]}>
            {p.badge && <span class="badge">{p.badge}</span>}
            <h3 class="h3" style="font-size:1.35rem">{p.name}</h3>
            <p style="opacity:.8;font-size:.95rem">{p.summary}</p>
            <div class="price"><b>${p.price}</b>{p.regularPrice > p.price && <s>${p.regularPrice.toLocaleString('en-US')}</s>}</div>
            {p.regularPrice > p.price && <span class="save">You save ${(p.regularPrice - p.price).toLocaleString('en-US')}</span>}
            <ul>{p.features.map((f) => <li><Fragment set:html={TICK} />{f}</li>)}</ul>
            <p style="font-size:.88rem;opacity:.75">{p.delivery}</p>
            <a class:list={['btn', p.highlight ? 'btn-white' : 'btn-ink']} href={`/contact/?package=${p.id}`} data-track="bfcm_claim" data-track-label={p.name} data-track-value={p.price}>Claim this slot <Fragment set:html={UA} /></a>
          </div>
        ))}
      </div>
      {bfcm.addons.length > 0 && <div class="addons rv">{bfcm.addons.map((a) => <span>{a.name} <b>{a.price}</b></span>)}</div>}
      {bfcm.guarantee && <div class="guarantee rv"><b>The guarantee</b>{bfcm.guarantee}</div>}
    </div>
  </section>

  <section class="alt">
    <div class="wrap steps-grid" style="align-items:start">
      <div>
        <p class="kicker rv">What usually leaks</p>
        <h2 class="h2 rv" style="margin:14px 0 28px">Fixed in your <span class="it">sprint</span></h2>
        <ul class="fix-list" style="grid-template-columns:1fr">{leaks.map((l) => <li class="rv">{l}</li>)}</ul>
      </div>
      <div>
        <p class="kicker rv">How it works</p>
        <h2 class="h2 rv" style="margin:14px 0 20px">Live in <span class="it">48 hours</span></h2>
        <ol class="steps">{steps.map((s, i) => <li class="rv"><span class="n">0{i + 1}</span><div><h3 class="h3">{s[0]}</h3><p>{s[1]}</p></div></li>)}</ol>
      </div>
    </div>
  </section>

  <Faq items={bfcm.faqs} title="Offer questions" />
  <CtaNight title="Not sure which package fits?" copy="Send your URL. You get a short video with the top leaks on your store and the package that fits, within 48 hours." />
</Base>
