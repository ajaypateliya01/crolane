---
export const prerender = true;

import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqList from '../components/FaqList.astro';
import { SITE } from '../config/site';

const title = `Contact | ${SITE.name}`;
const description =
  'Tell us where your customer journey feels stuck. You will get an honest reply about fit, scope and the most sensible next step.';

const faqs = [
  {
    q: 'What should I include in the message?',
    a: 'The business problem beats the service name. Where you think visitors or customers drop off, what you have already tried, and what a good outcome would look like. Links help, but they are not required.',
  },
  {
    q: 'Will my details be used for anything else?',
    a: 'No. The form exists to reply to your enquiry. We do not add senders to marketing lists from this form, and we do not sell or share contact details.',
  },
  {
    q: 'What if we are not a fit?',
    a: 'You will hear that plainly, along with any suggestion of what would make more sense. A short, honest no is better for both sides than a slow, awkward yes.',
  },
];
---

<Base title={title} description={description} canonicalPath="/contact/">
  <section class="ct-hero" aria-labelledby="contact-title">
    <div class="ct-hero-bg" aria-hidden="true"></div>
    <div class="container-x">
      <p class="eyebrow" data-reveal="fade">Contact</p>
      <h1 class="display-lg" id="contact-title" data-reveal>
        Tell us where you think the journey <span class="display-italic">loses people</span>.
      </h1>
      <p class="lede" data-reveal data-reveal-delay="0.08">
        A few sentences about the problem is enough to start. We reply to every enquiry by
        email, including the ones where we are not the right fit.
      </p>
    </div>
  </section>

  <section class="section-sm ct-main tone-paper" aria-label="Contact form and details">
    <div class="container-x ct-grid">
      <div class="ct-form-col" data-reveal>
        <p class="label-mono ct-form-label">Send an enquiry</p>
        <div class="ct-form-card">
          <ContactForm />
        </div>
      </div>

      <aside class="ct-side">
        <div class="ct-card" data-reveal="right">
          <p class="label-mono">What happens next</p>
          <ol class="ct-steps">
            <li>
              <span>1</span>
              <p><strong>We read it properly.</strong> A person, not an autoresponder sequence.</p>
            </li>
            <li>
              <span>2</span>
              <p><strong>You get an honest reply.</strong> Fit, initial thoughts, and what a sensible scope could involve.</p>
            </li>
            <li>
              <span>3</span>
              <p><strong>If it fits, a written scope.</strong> Deliverables, access, timing and cost before any work starts.</p>
            </li>
          </ol>
        </div>

        <div class="ct-card ct-mail" data-reveal="right" data-reveal-delay="0.08">
          <p class="label-mono">Prefer email?</p>
          <a class="ct-mail-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <p class="ct-mail-note">
            The same inbox. Use whatever is easiest for you.
          </p>
        </div>

        <div class="ct-card ct-honest" data-reveal="right" data-reveal-delay="0.14">
          <p class="label-mono">Straight answers</p>
          <p>
            No discovery call marathon, no gated PDF, no obligation attached to the first
            conversation. If the answer is &ldquo;you do not need this yet&rdquo;, that is what
            you will hear.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-sm" aria-labelledby="ct-faq-title">
    <div class="container-x ct-faq">
      <div>
        <p class="eyebrow" data-reveal="fade">Before you write</p>
        <h2 class="display-md" id="ct-faq-title" data-reveal>Quick answers</h2>
      </div>
      <div data-reveal="fade">
        <FaqList items={faqs} idPrefix="contact-faq" />
      </div>
    </div>
  </section>
</Base>

<style>
  .ct-hero {
    position: relative;
    padding-top: clamp(7.5rem, 14vh, 10rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    background: var(--color-paper);
    overflow: clip;
  }

  .ct-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 15% 20%, rgb(62 78 245 / 0.1), transparent 70%),
      radial-gradient(55% 65% at 90% 90%, rgb(200 56 95 / 0.08), transparent 70%);
    pointer-events: none;
  }

  .ct-hero .container-x {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .ct-hero h1 {
    max-width: 17ch;
  }

  .ct-main {
    background: var(--color-paper);
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .ct-form-label {
    margin-bottom: 0.9rem;
  }

  .ct-form-card {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 24px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: var(--shadow-lift);
  }

  .ct-side {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    position: sticky;
    top: 6.5rem;
  }

  .ct-card {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 20px;
    padding: 1.4rem 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  .ct-card > .label-mono {
    margin-bottom: 0.9rem;
  }

  .ct-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ct-steps li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
  }

  .ct-steps li span {
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    display: grid;
    place-items: center;
    transform: translateY(0.15rem);
  }

  .ct-steps p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .ct-steps strong {
    color: var(--color-ink);
    font-weight: 610;
  }

  .ct-mail {
    background: linear-gradient(150deg, color-mix(in srgb, var(--color-indigo) 6%, #fff), #fff);
    border-color: color-mix(in srgb, var(--color-indigo) 25%, transparent);
  }

  .ct-mail-link {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--color-indigo);
    text-decoration: underline;
    text-underline-offset: 4px;
    word-break: break-all;
  }

  .ct-mail-note {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-ink-3);
  }

  .ct-honest {
    background: color-mix(in srgb, var(--color-amber) 6%, #fff);
    border-color: color-mix(in srgb, var(--color-amber) 25%, transparent);
  }

  .ct-honest p:not(.label-mono) {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .ct-faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .ct-faq > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 7rem;
  }

  @media (max-width: 64rem) {
    .ct-grid,
    .ct-faq {
      grid-template-columns: 1fr;
    }

    .ct-side {
      position: static;
    }

    .ct-faq > div:first-child {
      position: static;
    }
  }
</style>
