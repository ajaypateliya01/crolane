---
export const prerender = true;

import Base from '../layouts/Base.astro';
import NightHero from '../components/ui/NightHero.astro';
import Demo from '../components/ui/Demo.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaNight from '../components/ui/CtaNight.astro';
import { UA } from '../components/ui/Icons';
import { SITE } from '../config/site';
import site from '../content/settings/site.json';

const title = 'Contact CROLANE: Get a Fixed Quote in 24 Hours';
const description = 'Tell CROLANE what you need. Ajay replies personally within 24 hours with next steps or a fixed written quote. No sales call needed.';
---
<Base title={title} description={description}>
  <NightHero>
    <div>
      <p class="kicker" style="margin-bottom:18px">Contact</p>
      <h1 class="h1 sm">Tell us what you need. Get a quote in <span class="it">24 hours.</span></h1>
      <p class="lede" style="margin-top:22px">Share your site and goal. Ajay replies personally with next steps or a fixed written quote.</p>
    </div>
    <Demo kind="voice" dark />
  </NightHero>
  <section>
    <div class="wrap steps-grid" style="align-items:start">
      <div class="rv"><ContactForm /></div>
      <div class="cinfo">
        <div class="rv"><b>Reply within 24 hours</b><p>Every message is read and answered by Ajay, not a sales team.</p></div>
        <div class="rv"><b>Fixed written quote</b><p>After a short call you get a quote with scope and price locked.</p></div>
        <div class="rv"><b>Email</b><p><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p></div>
        <div class="rv"><b>LinkedIn</b><p><a class="link" href={site.founder.linkedin} target="_blank" rel="noopener">Connect with Ajay <Fragment set:html={UA} /></a></p></div>
      </div>
    </div>
  </section>
  <CtaNight title="Or start with a free audit" />
</Base>
