---
export const prerender = true;

import Base from '../layouts/Base.astro';
import NightHero from '../components/ui/NightHero.astro';
import Demo from '../components/ui/Demo.astro';
import Steps from '../components/ui/Steps.astro';
import IsoStack from '../components/ui/IsoStack.astro';
import Faq from '../components/ui/Faq.astro';
import CtaNight from '../components/ui/CtaNight.astro';
import { UA, TICK } from '../components/ui/Icons';
import { SERVICES, priceFor } from '../config/services';
import bfcm from '../content/settings/bfcm.json';
import { offerLive } from '../lib/offer';

const title = 'Pricing for CRO, A/B Testing and AI Services | CROLANE';
const description = 'How CROLANE pricing works: fixed written quotes for CRO audits, A/B testing and tracking, plus starting prices for AI receptionists, workflows and audits.';

const models = [
  { k: 'One-off', name: 'Audit or Sprint', copy: 'Find the leaks and fix the biggest ones in one focused project.', items: ['Full funnel and UX review', 'Top fixes built and shipped', 'Before and after check'], best: 'Best for stores that want quick wins first.', mid: false },
  { k: 'Ongoing', name: 'Experimentation Program', copy: 'A monthly program of research and A/B tests that compounds over time.', items: ['A new test most weeks', 'Roadmap and monthly review', 'Analytics kept clean'], best: 'Best for stores with steady traffic and orders.', mid: true },
  { k: 'Project', name: 'Build Project', copy: 'Tracking, AI voice agents, n8n workflows or landing pages, built to spec.', items: ['Clear spec and timeline', 'Tested before handover', 'Docs and walkthrough'], best: 'Best for a specific system you need built.', mid: false },
];
const ai = SERVICES.filter((s) => priceFor(s.id));
const faqs = [
  { q: 'Why is there no price list for CRO work?', a: 'Two stores never need the same work. A fixed quote for your exact scope is fairer than a package that over or under delivers.' },
  { q: 'What shapes my quote?', a: 'The pages in scope, your traffic and how many tests it supports, the tools you already have and how fast you need it live.' },
  { q: 'Is the quote really fixed?', a: 'Yes. If scope changes, the change is agreed in writing before any extra work starts.' },
  { q: 'How do I pay?', a: 'You get an invoice by email. PayPal, Wise and card are accepted. Work starts once access and payment are in.' },
  { q: 'Is there a minimum contract?', a: 'No. Programs run month to month after the first month.' },
];
---
<Base title={title} description={description}>
  <NightHero>
    <div>
      <p class="kicker" style="margin-bottom:18px">Pricing</p>
      <h1 class="h1 sm">Simple pricing. A fixed quote for your <span class="it">exact scope.</span></h1>
      <p class="lede" style="margin-top:22px">Every project gets a written quote within 24 hours of a short call. Scope and price are locked before any work starts.</p>
      <div class="actions">
        <a class="btn btn-white" href="/contact/" data-track="pricing_quote">Get a quote <Fragment set:html={UA} /></a>
        <a class="btn btn-line" href="#mini-audit">Start with a free audit</a>
      </div>
    </div>
    <Demo kind="dash" dark />
  </NightHero>

  <section>
    <div class="wrap">
      <div class="sec-title"><p class="kicker c rv">Ways to work</p><h2 class="h2 rv" style="margin-top:14px">Pick what fits your <span class="it">stage</span></h2></div>
      <div class="eng-grid">
        {models.map((m) => (
          <div class:list={['eng rv', { mid: m.mid }]}>
            <p class="kicker">{m.k}</p>
            <h3 class="serif" style="font-size:2rem">{m.name}</h3>
            <p class="muted">{m.copy}</p>
            <ul>{m.items.map((l) => <li><Fragment set:html={TICK} />{l}</li>)}</ul>
            <a class:list={['btn', m.mid ? 'btn-white' : 'btn-ink']} href="/contact/" data-track="pricing_model" data-track-label={m.name}>Get a custom quote <Fragment set:html={UA} /></a>
            <p class="best">{m.best}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-title"><h2 class="h2 rv">AI services <span class="it">starting prices</span></h2><p class="rv">AI builds have a clear starting point. Your final quote depends on integrations and call or task volume.</p></div>
      <table class="ptable rv">
        <thead><tr><th scope="col">Service</th><th scope="col">What you get</th><th scope="col">Starting from</th></tr></thead>
        <tbody>{ai.map((s) => <tr><td><a href={s.path}>{s.name}</a></td><td>{s.short}</td><td class="pr">{priceFor(s.id).replace(/^From\s*/i, '')}</td></tr>)}</tbody>
      </table>
      {offerLive && (
        <div class="offer-note rv">
          <div><b>{bfcm.eyebrow} offer is live</b><p>Fixed-price CRO packages from ${Math.min(...bfcm.packages.map((p) => p.price))}, only until the timer ends.</p></div>
          <a class="btn btn-white" href="/bfcm/" data-track="pricing_offer">See the offer <Fragment set:html={UA} /></a>
        </div>
      )}
    </div>
  </section>

  <section class="alt">
    <div class="wrap steps-grid">
      <div>
        <p class="kicker rv">The process</p>
        <h2 class="h2 rv" style="margin:14px 0 20px">From first message to <span class="it">results</span></h2>
        <Steps />
      </div>
      <IsoStack a="Audit" b="Program" c="Build" />
    </div>
  </section>

  <Faq items={faqs} />
  <CtaNight />
</Base>
