---
export const prerender = true;

import Base from '../layouts/Base.astro';
import PricingCards from '../components/PricingCards.astro';
import MiniAudit from '../components/MiniAudit.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { SERVICES } from '../config/services';
import { SITE } from '../config/site';
import pricing from '../content/settings/pricing.json';
import bfcm from '../content/settings/bfcm.json';
import { offerLive } from '../lib/offer';

const title = 'Pricing: Fixed-Price CRO, A/B Testing and AI Services | CROLANE';
const description =
  'Published, fixed prices for CRO sprints, A/B testing programs, GA4 tracking, AI agent workflows, AI voice agents and AI audits. No sales call needed.';

const AI_IDS = ['ai-automation', 'ai-voice-agents', 'ai-agent-audit'];
const priceOf = (id: string) => pricing.services.find((p) => p.id === id);
const groups = [
  { label: 'CRO, testing and analytics', items: SERVICES.filter((s) => !AI_IDS.includes(s.id)) },
  { label: 'AI services', items: SERVICES.filter((s) => AI_IDS.includes(s.id)) },
];

const faqs = [
  {
    q: 'How do I pay?',
    a: 'Pick a package or service and send your URL. You get an invoice by email (PayPal, Wise or card), usually within a few hours. Work starts once access and payment are in. All prices are in US dollars.',
  },
  {
    q: 'What if my project does not fit a package?',
    a: 'Send a short note about what you need. You get a fixed quote and a timeline within 24 hours, before you pay anything.',
  },
  {
    q: 'Are monthly plans locked in?',
    a: 'No. The A/B testing program and monthly care plans run month to month. A three-month testing plan is recommended because tests need time to reach a result, but you can stop at the end of any month.',
  },
  {
    q: 'Do you guarantee results?',
    a: 'No one can honestly guarantee a conversion lift. What is guaranteed is the scope: the work listed in your package, delivered on time. For audit sprints, if I cannot find at least 3 fixable leaks, you get a full refund.',
  },
  {
    q: 'Do you offer white-label work for agencies?',
    a: 'Yes. A/B tests are built white-label for agencies at $249 per test, or $899/month for a pack of four.',
  },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: 'CROLANE pricing',
    url: `${SITE.url}/pricing/`,
    itemListElement: pricing.packages.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.price,
      priceCurrency: 'USD',
      description: p.summary,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={title} description={description} canonicalPath="/pricing/" jsonLd={ld}>
  <section class="pr-hero" aria-labelledby="pr-title">
    <div class="container-x">
    <div class="pr-hero-inner">
      <p class="eyebrow" data-reveal="fade">Pricing</p>
      <h1 class="display-xl" id="pr-title" data-reveal>
        Fixed prices. <span class="display-italic">Shipped work.</span>
      </h1>
      <p class="lede" data-reveal data-reveal-delay="0.06">
        Every price is published, so you know the cost before we talk. No sales call needed: pick
        what fits, send your URL and get an invoice.
      </p>
      {
        offerLive && (
          <a class="pr-offer" href="/bfcm/" data-track="pricing_to_bfcm" data-reveal data-reveal-delay="0.12">
            <span class="pr-offer-tag">{bfcm.eyebrow}</span>
            <span>Sprint prices below are the Black Friday prices. See the full offer and countdown</span>
          </a>
        )
      }
    </div>
    </div>
  </section>

  <section class="section pr-packages" id="packages" aria-labelledby="pk-title">
    <div class="container-x">
      <div class="pr-head">
        <p class="eyebrow" data-reveal="fade">Conversion sprints</p>
        <h2 class="display-md" id="pk-title" data-reveal>Audit plus fixes, shipped live.</h2>
      </div>
      <PricingCards mode={offerLive ? 'sale' : 'regular'} />
    </div>
  </section>

  <section class="section pr-list tone-white" aria-labelledby="list-title">
    <div class="container-x">
      <div class="pr-head">
        <p class="eyebrow" data-reveal="fade">Every service</p>
        <h2 class="display-md" id="list-title" data-reveal>One price list, no surprises.</h2>
      </div>
      <div class="pr-groups">
        {
          groups.map((g) => (
            <div class="pr-group" data-reveal>
              <p class="label-mono pr-group-label">{g.label}</p>
              <ul class="pr-rows">
                {g.items.map((s) => {
                  const pr = priceOf(s.id);
                  return (
                    <li>
                      <a class="pr-row" href={s.path} data-track="pricing_service" data-track-label={s.id}>
                        <span class="pr-name">
                          <strong>{s.navTitle}</strong>
                          <span>{s.short}</span>
                        </span>
                        <span class="pr-price">
                          <strong>{pr?.from}</strong>
                          <span>{pr?.note}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="pr-agency" data-reveal>
        <p>
          <strong>Agencies:</strong> white-label A/B test builds at $249 per test, or $899/month for
          four. Your brief, your client's tool, your name on it.
        </p>
        <a class="btn btn-ghost" href="/contact/?service=ab-testing" data-track="pricing_agency">Send a brief</a>
      </div>
    </div>
  </section>

  <MiniAudit title="Not sure what you need? Start with a free video audit." />

  <section class="section faq-wrap" aria-labelledby="pr-faq-title">
    <div class="container-x pr-faq">
      <div>
        <p class="eyebrow" data-reveal="fade">FAQs</p>
        <h2 class="display-md" id="pr-faq-title" data-reveal>About pricing and payment.</h2>
      </div>
      <FaqList items={faqs} idPrefix="pricing-faq" />
    </div>
  </section>

  <CtaBand
    eyebrow="Custom work"
    title="Need something that is not on the list?"
    copy="Send a short note about the problem. You get a fixed price and a timeline within 24 hours."
    primaryLabel="Get a fixed quote"
    primaryHref="/contact/"
  />
</Base>

<style>
  .pr-hero {
    padding: clamp(7rem, 14vh, 9rem) 0 clamp(2.5rem, 5vh, 3.5rem);
    background: var(--color-paper);
  }

  .pr-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 52rem;
  }

  .pr-offer {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    align-self: flex-start;
    padding: 0.7rem 1rem;
    border-radius: 12px;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.92rem;
  }

  .pr-offer:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pr-offer-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--color-signal);
    color: var(--color-ink);
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
  }

  .pr-packages {
    background: var(--color-paper-3);
  }

  .pr-head {
    margin-bottom: 2.2rem;
    max-width: 44rem;
  }

  .pr-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .pr-group-label {
    padding-bottom: 0.7rem;
    border-bottom: 1.5px solid var(--color-ink);
  }

  .pr-rows {
    list-style: none;
  }

  .pr-row {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .pr-row:hover strong {
    color: var(--color-indigo);
  }

  .pr-name,
  .pr-price {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pr-name strong,
  .pr-price strong {
    font-weight: 600;
    font-size: 1rem;
  }

  .pr-name span {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .pr-price {
    flex: none;
    text-align: right;
    max-width: 12rem;
  }

  .pr-price span {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--color-ink-3);
  }

  .pr-agency {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 16px;
    background: var(--color-paper);
  }

  .pr-agency p {
    max-width: 44rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .faq-wrap {
    background: var(--color-paper);
  }

  .pr-faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  @media (max-width: 56rem) {
    .pr-groups,
    .pr-faq {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .pr-row {
      flex-direction: column;
      gap: 0.5rem;
    }

    .pr-price {
      text-align: left;
      max-width: none;
    }
  }
</style>
