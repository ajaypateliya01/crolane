---
export const prerender = true;

import { SERVICES } from '../config/services';
import { SITE } from '../config/site';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import ServiceRows from '../components/ServiceRows.astro';
import AbLab from '../components/AbLab.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import PricingCards from '../components/PricingCards.astro';
import Founder from '../components/Founder.astro';
import Reviews from '../components/Reviews.astro';
import Leaks from '../components/Leaks.astro';
import Compare from '../components/Compare.astro';
import MiniAudit from '../components/MiniAudit.astro';
import bfcm from '../content/settings/bfcm.json';

const title = 'Shopify CRO, A/B Testing, GA4 & AI Voice Agents | CROLANE';
const description = SITE.description;

const faqs = [
  {
    q: 'How much does a Shopify CRO audit cost?',
    a: 'Published audit prices usually range from about $500 to over $2,000. CROLANE sprints start at $599 for a mobile product page and cart review with the top 3 fixes built and shipped, and $799 for six fixes plus a GA4 tracking check. Prices are fixed before work starts.',
  },
  {
    q: 'What is the difference between a CRO audit and A/B testing?',
    a: 'An audit finds where visitors hesitate and fixes the clear problems directly. An A/B test is for changes where the right answer is not obvious: two versions run side by side and the data decides. Most stores need the fixes first and tests second.',
  },
  {
    q: 'Do I need a lot of traffic for A/B testing?',
    a: 'For reliable A/B tests you generally need a few hundred conversions per variation over the test period. Smaller stores get more from fixing clear friction and making sure tracking is right, then testing the bigger decisions later.',
  },
  {
    q: 'How does an engagement start?',
    a: 'With a conversation. You tell us where you think the journey loses people, we ask practical questions, and if it looks like a fit we send a written scope with deliverables, access needs, timing and cost. Nothing starts until you approve it.',
  },
  {
    q: 'Do you guarantee conversion lifts?',
    a: 'No, and you should be careful around anyone who does. We guarantee careful work, honest measurement and honest read outs. How much a business improves depends on its traffic, offer, market and how well changes are implemented.',
  },
  {
    q: 'Are the numbers and demos on this site real results?',
    a: 'No. Every metric, heatmap, conversation and experiment shown here is illustrative demo data built to explain how the work functions. We do not publish fabricated client results, logos or testimonials.',
  },
  {
    q: 'What access do you need from us?',
    a: 'It depends on the service. Analytics and tag work needs access to your GA4 and tag manager properties. Audits need a way to review the live experience, ideally with session data if you have it. Automation and voice projects need the tools you want connected. We list exactly what is needed in the scope.',
  },
  {
    q: 'How long does the work take?',
    a: 'It depends on scope and access. Timelines are agreed in writing before work starts, including anything we are waiting on from your side, so there are no moving targets.',
  },
  {
    q: 'Can you work alongside our developers or agency?',
    a: 'Yes. Findings, event plans, test designs and automation specs are documented so whoever implements them can follow the logic. If you would like us to implement within scope, that can be part of the project.',
  },
  {
    q: 'Is advanced CRM integration or enterprise automation included by default?',
    a: 'No. Standard automation covers practical, well defined workflows with clear review points. Complex CRM, calendar or telephony integrations are scoped separately based on your stack, access and feasibility.',
  },
];

const homeLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'CROLANE services',
    itemListElement: SERVICES.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
      url: `${SITE.url}${s.path}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];


---

<Base title={title} description={description} jsonLd={homeLd}>
  <Hero />
  <Ticker />
  <Leaks />
  <MiniAudit dark />
  {
    bfcm.enabled && (
      <section class="section home-offer" aria-labelledby="home-offer-title">
        <div class="container-x">
          <div class="ho-head">
            <p class="eyebrow" data-reveal="fade">{bfcm.eyebrow}</p>
            <h2 class="display-lg" id="home-offer-title" data-reveal>
              Fixed-price sprints, <span class="display-italic">live before Monday.</span>
            </h2>
            <p class="lede" data-reveal>{bfcm.lede}</p>
          </div>
          <PricingCards compact />
          <p class="ho-more" data-reveal>
            <a class="link-arrow" href="/bfcm/" data-track="home_offer_details">See everything included, FAQs and the guarantee →</a>
          </p>
        </div>
      </section>
    )
  }
  <Compare />
  <Founder />
  <ServiceRows />
  <Reviews />
  <AbLab />

  <!-- FAQ -->
  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="container-x faq-grid">
      <div class="faq-left">
        <p class="eyebrow" data-reveal="fade">FAQs</p>
        <h2 class="display-md" id="faq-title" data-reveal>Questions worth answering first.</h2>
        <p class="faq-sub" data-reveal data-reveal-delay="0.06">
          Anything not covered here?
          <a href="/contact/">Send it over</a>, we answer in plain language.
        </p>
      </div>
      <div data-reveal="fade">
        <FaqList items={faqs} idPrefix="home-faq" />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Homepage rhythm: a tighter, landing-page pace than the default section pad. */
  .section {
    padding-block: clamp(3.8rem, 7.5vw, 6.4rem);
  }

  .home-offer {
    background: var(--color-paper-3);
  }

  .ho-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.8rem;
    margin-bottom: 3rem;
  }

  .ho-more {
    margin-top: 2rem;
    text-align: center;
  }

  /* Process */
  .process {
    background: #fff;
  }

  .process-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    counter-reset: none;
  }

  .process-step {
    position: relative;
    padding: 1.6rem 1.4rem 1.7rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 18px;
    background: linear-gradient(180deg, #fff, var(--color-paper));
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }

  .process-step:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lift);
  }

  .process-step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.4rem;
    right: 1.4rem;
    height: 3px;
    border-radius: 0 0 4px 4px;
    background: linear-gradient(90deg, var(--color-indigo), color-mix(in srgb, var(--color-indigo) 30%, transparent));
    opacity: 0.7;
  }

  .pr-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-3);
  }

  .process-step h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 400;
    margin: 0.6rem 0 0.55rem;
  }

  .process-step p {
    font-size: 0.89rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .process-note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-size: 0.875rem;
    color: var(--color-ink-3);
    max-width: 46rem;
    padding-top: 1.25rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  /* FAQ */
  .faq-section {
    background: var(--color-paper);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .faq-left {
    position: sticky;
    top: 7rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .faq-sub {
    font-size: 0.95rem;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  .faq-sub a {
    color: var(--color-indigo);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 64rem) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-left {
      position: static;
    }
  }

  @media (max-width: 40rem) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
