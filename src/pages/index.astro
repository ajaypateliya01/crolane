---
export const prerender = true;

import Base from '../layouts/Base.astro';
import NightHero from '../components/ui/NightHero.astro';
import Demo from '../components/ui/Demo.astro';
import Carousel from '../components/ui/Carousel.astro';
import Steps from '../components/ui/Steps.astro';
import IsoStack from '../components/ui/IsoStack.astro';
import Faq from '../components/ui/Faq.astro';
import CtaNight from '../components/ui/CtaNight.astro';
import Founder from '../components/ui/Founder.astro';
import Reviews from '../components/ui/Reviews.astro';
import { UA } from '../components/ui/Icons';
import { SERVICES } from '../config/services';
import { SITE } from '../config/site';
import home from '../content/settings/home.json';
import site from '../content/settings/site.json';
import bfcm from '../content/settings/bfcm.json';
import { offerLive, offerSafeHref } from '../lib/offer';

const title = 'CRO Agency for Shopify and Ecommerce Brands | CROLANE';
const description =
  'Developer-led CRO for Shopify and ecommerce brands: audits that end in shipped fixes, A/B testing, GA4 tracking and AI voice and workflow automation.';

// Split the admin headline around the highlighted word so it can be set in italic.
const hi = home.highlight?.trim();
const idx = hi ? home.headline.indexOf(hi) : -1;
const before = idx >= 0 ? home.headline.slice(0, idx) : home.headline;
const after = idx >= 0 ? home.headline.slice(idx + hi.length) : '';
const primaryHref = offerSafeHref(home.primaryHref);
const primaryLabel = !offerLive && home.primaryHref.startsWith('/bfcm') ? 'Get a free audit' : home.primaryLabel;
const primaryTarget = !offerLive && home.primaryHref.startsWith('/bfcm') ? '#mini-audit' : primaryHref;

const tabs = [
  { kind: 'ab', tag: 'A/B', name: 'A/B testing', sub: 'Variants, lift and confidence, live' },
  { kind: 'ga4', tag: 'GA4', name: 'GA4 tracking', sub: 'Every event checked before it counts' },
  { kind: 'voice', tag: 'AI', name: 'AI receptionist', sub: 'Calls answered and booked 24/7' },
  { kind: 'flow', tag: 'n8n', name: 'AI workflows', sub: 'Leads qualified and routed in seconds' },
] as const;

const faqs = [
  { q: 'How much does CRO work cost?', a: 'Every store needs different work, so we quote after a short call. Your quote is fixed in writing before anything starts. AI builds show a starting price on their pages, and limited offers like Black Friday have fixed package prices.' },
  { q: 'What is the difference between a CRO audit and A/B testing?', a: 'An audit finds where visitors hesitate and fixes the clear problems directly. An A/B test is for changes where the right answer is not obvious: two versions run side by side and the data decides. Most stores need the fixes first and tests second.' },
  { q: 'Do I need a lot of traffic for A/B testing?', a: 'For reliable tests you generally need a few hundred conversions per variation over the test period. Smaller stores get more from fixing clear friction and making sure tracking is right, then testing the bigger decisions later.' },
  { q: 'Do you guarantee conversion lifts?', a: 'No, and be careful around anyone who does. We guarantee careful work, honest measurement and honest read-outs. Results depend on your traffic, offer and market.' },
  { q: 'Are the numbers in the demos real client results?', a: 'No. Every metric, conversation and experiment shown in the demos is illustrative, built to show how the work functions. We do not publish made up client results, logos or testimonials.' },
  { q: 'Can you work alongside our developers or agency?', a: 'Yes. Findings, event plans, test designs and automation specs are documented so anyone can follow them. CROLANE also builds tests white label for agencies.' },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: SERVICES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE.url}${s.path}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={title} description={description} jsonLd={ld}>
  <NightHero logos>
    <div>
      <p class="kicker" style="margin-bottom:22px">{home.eyebrow}</p>
      <h1 class="h1">{before}{idx >= 0 && <span class="it">{hi}</span>}{after}</h1>
      <p class="lede" style="margin-top:24px">{home.lede}</p>
      <div class="actions">
        <a class="btn btn-white" href={primaryTarget} data-track="hero_primary">{primaryLabel} <Fragment set:html={UA} /></a>
        {primaryTarget !== '#mini-audit' && <a class="btn btn-line" href={home.secondaryHref === '#mini-audit' ? '#mini-audit' : home.secondaryHref} data-track="hero_secondary">{home.secondaryLabel}</a>}
      </div>
      <div class="trust" style="margin-top:28px"><Founder /><span><b>Work directly with Ajay</b><br />The person who audits ships the fix</span></div>
    </div>
    <Demo kind="result" toggle />
  </NightHero>

  <Carousel list={SERVICES} kicker="Services" title="Where we move your numbers" sub="Use one service or combine them. Every project starts with data, not guesses." />

  <section class="alt">
    <div class="wrap">
      <div class="sec-title">
        <p class="kicker c rv">Live demos</p>
        <h2 class="h2 rv" style="margin-top:14px">See the work before you <span class="it">hire us</span></h2>
        <p class="rv">Real examples of what we build. Numbers are illustrative.</p>
      </div>
      <div class="show-grid" data-tabs>
        <div class="tabs" role="tablist" aria-label="Demos">
          {tabs.map((t, i) => (
            <button class="tab" type="button" role="tab" id={`tab-${t.kind}`} aria-controls={`panel-${t.kind}`} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="ti">{t.tag}</span><span><b>{t.name}</b><span class="s">{t.sub}</span></span>
            </button>
          ))}
        </div>
        <div>
          {tabs.map((t, i) => (
            <div role="tabpanel" id={`panel-${t.kind}`} aria-labelledby={`tab-${t.kind}`} hidden={i !== 0}><Demo kind={t.kind} /></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap steps-grid">
      <div>
        <p class="kicker rv">How it works</p>
        <h2 class="h2 rv" style="margin:14px 0 20px">Three steps. <span class="it">No surprises.</span></h2>
        <Steps />
      </div>
      <IsoStack a="Audit" b="Quote" c="Growth" />
    </div>
  </section>

  <section class="night" style="padding:clamp(56px,7vw,96px) 0">
    <div class="wrap">
      <p class="kicker rv">Why CROLANE</p>
      <h2 class="h2 rv" style="margin:14px 0 36px;max-width:820px">Developer-led, so the fix actually <span class="it">ships</span></h2>
      <div class="why">
        {site.proofPoints.map((p, i) => <div class="rv"><span>0{i + 1}</span><p>{p}</p></div>)}
      </div>
      {offerLive && (
        <div class="offer-note rv" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);margin-top:40px">
          <div><b>{bfcm.eyebrow}</b><p>Fixed-price CRO packages from ${Math.min(...bfcm.packages.map((p) => p.price))}, {bfcm.slots} slots only.</p></div>
          <a class="btn btn-white" href="/bfcm/" data-track="home_offer">See the offer <Fragment set:html={UA} /></a>
        </div>
      )}
    </div>
  </section>

  <Reviews />
  <Faq items={faqs} />
  <CtaNight />
</Base>

<style>
  .why { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid rgba(255,255,255,.14); }
  .why div { padding: 26px 24px 8px 0; border-right: 1px solid rgba(255,255,255,.1); margin-right: 24px; }
  .why div:last-child { border-right: 0; margin-right: 0; }
  .why span { font-family: var(--mono); font-size: .8rem; color: var(--lav); }
  .why p { margin-top: 14px; color: #e6e1f7; font-size: 1.02rem; line-height: 1.6; }
  @media (max-width: 900px) {
    .why { grid-template-columns: 1fr 1fr; }
    .why div:nth-child(2) { border-right: 0; margin-right: 0; }
  }
  @media (max-width: 560px) {
    .why { grid-template-columns: 1fr; }
    .why div { border-right: 0; margin-right: 0; border-bottom: 1px solid rgba(255,255,255,.1); padding-bottom: 22px; }
  }
</style>
