---
export const prerender = true;

import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base
  title={`Page not found | ${SITE.name}`}
  description="This page does not exist. Find your way back to CROLANE services and contact."
  canonicalPath="/404"
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf-bg" aria-hidden="true"></div>
    <div class="container-x nf-inner">
      <p class="eyebrow" data-reveal="fade">Error 404</p>
      <h1 class="display-xl" id="nf-title" data-reveal>
        This page left the <span class="display-italic">funnel</span>.
      </h1>
      <p class="lede" data-reveal data-reveal-delay="0.08">
        The address does not exist on this site. The journey continues from one of these
        routes.
      </p>
      <div class="nf-links" data-reveal data-reveal-delay="0.14">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-ghost" href="/services/">View services</a>
        <a class="btn btn-ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    padding-top: clamp(7rem, 14vh, 9rem);
    padding-bottom: clamp(4rem, 8vh, 6rem);
    background: var(--color-paper);
    overflow: clip;
  }

  .nf-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(45% 55% at 80% 25%, rgb(62 78 245 / 0.1), transparent 70%),
      radial-gradient(40% 50% at 15% 80%, rgb(199 116 21 / 0.1), transparent 70%);
    pointer-events: none;
  }

  .nf-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .nf h1 {
    max-width: 14ch;
  }

  .nf-links {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
</style>
