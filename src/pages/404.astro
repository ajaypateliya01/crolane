---
export const prerender = true;

import Base from '../layouts/Base.astro';
import NightHero from '../components/ui/NightHero.astro';
import CtaNight from '../components/ui/CtaNight.astro';
import { SITE } from '../config/site';
---
<Base title={`Page not found | ${SITE.name}`} description="This page does not exist. Find your way back to CROLANE services and contact." canonicalPath="/404">
  <NightHero single>
    <div>
      <p class="kicker" style="margin-bottom:18px">Error 404</p>
      <h1 class="h1 sm">This page left the <span class="it">funnel.</span></h1>
      <p class="lede" style="margin-top:22px">The address does not exist on this site. Pick up the journey from here.</p>
      <div class="actions">
        <a class="btn btn-white" href="/">Back to home</a>
        <a class="btn btn-line" href="/services/">View services</a>
        <a class="btn btn-line" href="/contact/">Contact</a>
      </div>
    </div>
  </NightHero>
  <CtaNight />
</Base>
