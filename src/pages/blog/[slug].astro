---
export const prerender = true;

import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NightHero from '../../components/ui/NightHero.astro';
import Founder from '../../components/ui/Founder.astro';
import Ill from '../../components/ui/Ill.astro';
import CtaNight from '../../components/ui/CtaNight.astro';
import { UA } from '../../components/ui/Icons';
import { artFor } from '../../lib/blog-art';
import { getPosts, CATEGORY_LABELS, fmtDate, readMins } from '../../lib/blog';
import { SITE } from '../../config/site';
import site from '../../content/settings/site.json';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    mainEntityOfPage: url,
    image: post.data.cover ? `${SITE.url}${post.data.cover}` : `${SITE.url}/images/og-default.png`,
    author: { '@type': 'Person', name: site.founder.name, url: site.founder.linkedin },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
const posts = await getPosts();
const related = [...posts.filter((p) => p.id !== post.id && p.data.category === post.data.category), ...posts.filter((p) => p.id !== post.id && p.data.category !== post.data.category)].slice(0, 3);
---

<Base
  title={post.data.title.length > 50 ? post.data.title : `${post.data.title} | CROLANE`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  ogType="article"
  ogImage={post.data.cover || undefined}
  jsonLd={ld}
>
  <NightHero single>
    <div style="max-width:860px">
      <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span>{CATEGORY_LABELS[post.data.category] || 'Guide'}</span></nav>
      <h1 class="h1 sm">{post.data.title}</h1>
      {post.data.description && <p class="lede" style="margin-top:22px">{post.data.description}</p>}
      <div class="trust" style="margin-top:26px"><Founder /><span><b><a href={site.founder.linkedin} target="_blank" rel="noopener">{site.founder.name}</a></b><br />{fmtDate(post.data.date)}, {readMins(post.body)} min read</span></div>
    </div>
  </NightHero>
  <section>
    <div class="wrap">
      {post.data.cover && <img class="post-cover" src={post.data.cover} alt="" width="1200" height="630" />}
      <article class="prose"><Content /></article>
      <div class="offer-note" style="max-width:740px;margin:48px auto 0">
        <div><b>Want this checked on your store?</b><p>Get a free video audit with the top leaks, within 48 hours.</p></div>
        <a class="btn btn-white" href="#mini-audit" data-track="post_audit">Get a free audit <Fragment set:html={UA} /></a>
      </div>
      <div class="author"><Founder size="lg" /><div><b>{site.founder.name}</b><p>{site.founder.role}</p></div></div>
    </div>
  </section>
  <section class="alt">
    <div class="wrap">
      <div class="sec-title"><h2 class="h2">Keep <span class="it">reading</span></h2></div>
      <div class="grid3">
        {related.map((p) => (
          <a class="post-card" href={`/blog/${p.id}/`}>
            <Ill name={artFor(p.data.category)} />
            <div class="body"><span class="tagx">{CATEGORY_LABELS[p.data.category] || 'Guide'}</span><h3 class="h3">{p.data.title}</h3><p>{p.data.description}</p><span class="link">Read article <Fragment set:html={UA} /></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaNight />
</Base>
