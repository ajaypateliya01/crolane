---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import NightHero from '../../components/ui/NightHero.astro';
import Ill from '../../components/ui/Ill.astro';
import CtaNight from '../../components/ui/CtaNight.astro';
import { UA } from '../../components/ui/Icons';
import { getPosts, CATEGORY_LABELS, fmtDate, readMins } from '../../lib/blog';
import { artFor } from '../../lib/blog-art';
import { SITE } from '../../config/site';

const posts = await getPosts();
const title = 'CRO, GA4 and AI Automation Blog | CROLANE';
const description = 'Practical guides on Shopify CRO, A/B testing, GA4 tracking, AI voice receptionists and n8n agents. Written by a developer who builds them.';
const ld = [{ '@context': 'https://schema.org', '@type': 'Blog', name: 'CROLANE Blog', url: `${SITE.url}/blog/`, publisher: { '@id': `${SITE.url}/#organization` } }];
---
<Base title={title} description={description} canonicalPath="/blog/" jsonLd={ld}>
  <NightHero single>
    <div>
      <p class="kicker" style="margin-bottom:18px">Blog</p>
      <h1 class="h1 sm">CRO, analytics and AI, <span class="it">explained plainly</span></h1>
      <p class="lede" style="margin-top:22px">Hands-on notes from building A/B tests, tracking and AI agents for real stores. What to check, and how to fix it.</p>
    </div>
  </NightHero>
  <section>
    <div class="wrap">
      <div class="grid3">
        {posts.map((p) => (
          <div class="rv">
            <a class="post-card" href={`/blog/${p.id}/`}>
              <Ill name={artFor(p.data.category)} />
              <div class="body">
                <span class="tagx">{CATEGORY_LABELS[p.data.category] || 'Guide'} &nbsp; {readMins(p.body)} min read</span>
                <h2 class="h3">{p.data.title}</h2>
                <p>{p.data.description}</p>
                <span class="link">Read article <Fragment set:html={UA} /></span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaNight />
</Base>
