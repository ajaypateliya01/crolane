---
export const prerender = true;

import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config/site';

const title = `About | ${SITE.name}`;
const description =
  'How CROLANE works: evidence based conversion decisions, careful measurement, honest scoping and practical AI, with clear limits on what is promised.';

const principles = [
  {
    num: '01',
    title: 'The question comes first',
    body: 'Every engagement starts with the business decision in front of you. Tools, tests and automations are only interesting in service of that decision.',
  },
  {
    num: '02',
    title: 'Data has to earn trust',
    body: 'Before conclusions, collection. We validate events, flag what is missing and label anything that is estimated, modelled or incomplete.',
  },
  {
    num: '03',
    title: 'Small bets over big rebuilds',
    body: 'Where evidence supports it, targeted changes beat wholesale redesigns. Where a bigger change is genuinely needed, the evidence should make that obvious.',
  },
  {
    num: '04',
    title: 'AI with a supervisor',
    body: 'Models are useful for reading, drafting, classifying and answering within boundaries. People keep the commitments and the edge cases.',
  },
];

const donts = [
  'Guaranteed conversion lifts or fixed win rates.',
  'Invented case studies, logos, testimonials or awards.',
  'Vague scopes designed to hide what the work actually includes.',
  'Locking your data or accounts behind our tools.',
  'Automation that runs unsupervised on customer commitments from day one.',
  'Sprawling into every marketing service under the sun.',
];

const processSteps = [
  {
    num: '01',
    title: 'Conversation',
    body: 'A short call or email thread about the business problem, the current experience and what you have already tried. No pitch deck, no obligation.',
  },
  {
    num: '02',
    title: 'Scope',
    body: 'A written scope: deliverables, access needed, timeline and cost. Questions and pushback are welcome before anything is approved.',
  },
  {
    num: '03',
    title: 'Implementation',
    body: 'The actual work with checkpoints. Analytics validated, experiments documented, automations reviewed before anything customer facing goes live.',
  },
  {
    num: '04',
    title: 'Review',
    body: 'A clear read-out: what was found, what was decided, what changed and what is worth doing next. Everything documented for whoever implements next.',
  },
];
---

<Base title={title} description={description} canonicalPath="/about/">
  <section class="ab-hero" aria-labelledby="about-title">
    <div class="ab-hero-bg" aria-hidden="true"></div>
    <div class="container-x ab-hero-grid">
      <div class="ab-hero-copy">
        <p class="eyebrow" data-reveal="fade">About CROLANE</p>
        <h1 class="display-lg" id="about-title" data-reveal>
          Careful work for people who prefer <span class="display-italic">evidence to theatre</span>.
        </h1>
        <p class="lede" data-reveal data-reveal-delay="0.08">
          CROLANE is a focused practice for conversion optimization, measurement and practical AI.
          We help businesses understand what their digital experience is actually doing, fix what
          deserves fixing, and automate what should never have been manual.
        </p>
      </div>
      <figure class="ab-hero-art" data-reveal="scale" data-reveal-delay="0.1">
        <img
          src="/images/art-studio.jpg"
          alt="Design studio desk with a notebook, ruler, glass of water and a card showing a hand drawn curve"
          width="640"
          height="480"
          loading="eager"
        />
        <figcaption class="chip"><span class="chip-dot"></span>The practice behind the site</figcaption>
      </figure>
    </div>
  </section>

  <section class="section tone-white" aria-labelledby="principles-title">
    <div class="container-x ab-split">
      <div class="ab-sticky">
        <p class="eyebrow" data-reveal="fade">How we think</p>
        <h2 class="display-md" id="principles-title" data-reveal>Four working principles.</h2>
        <p class="ab-note" data-reveal data-reveal-delay="0.06">
          Not a proprietary framework, just the standards that keep the work useful and the
          advice honest.
        </p>
      </div>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li data-reveal data-reveal-delay={String(0.05 * i)}>
              <span class="pr-num">{p.num}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section tone-paper" aria-labelledby="dont-title">
    <div class="container-x dont-grid">
      <div>
        <p class="eyebrow" data-reveal="fade">Honest limits</p>
        <h2 class="display-md" id="dont-title" data-reveal>What we will not do</h2>
        <p class="ab-note" data-reveal data-reveal-delay="0.06">
          The fastest way to trust a supplier is to know where they draw their lines. These
          are ours.
        </p>
      </div>
      <ul class="dont-list" data-reveal="fade">
        {donts.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  <section class="section tone-white" id="process" aria-labelledby="about-process-title">
    <div class="container-x">
      <SectionHeading
        eyebrow="Working together"
        title="The process, in plain language"
        lede="The depth changes from service to service. The shape of working together does not."
        id="about-process-title"
      />
      <ol class="ab-process">
        {
          processSteps.map((s, i) => (
            <li class="ab-step" data-reveal data-reveal-delay={String(0.06 * i)}>
              <span class="step-tag" aria-hidden="true">Step {s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="ab-who" data-reveal>
        <div>
          <p class="label-mono">Who this is for</p>
          <p>
            Growing e-commerce and service businesses with real traffic, real questions and
            someone on the team who owns the outcome. Teams with an agency or developers of
            their own are welcome: findings are written to be implemented by whoever is best
            placed to do it.
          </p>
        </div>
        <div>
          <p class="label-mono">Who this is not for</p>
          <p>
            Anyone looking for guaranteed numbers, secret formulas or a supplier who will not
            say no. If the honest answer is that you do not need us yet, you will hear that in
            the first conversation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Say hello"
    title="A first conversation costs nothing but a paragraph."
    copy="Tell us the business problem in a few sentences. We will reply with honest thoughts on whether CROLANE is the right fit and what a sensible next step looks like."
  />
</Base>

<style>
  .ab-hero {
    position: relative;
    padding-top: clamp(7.5rem, 14vh, 10rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    background: var(--color-paper);
    overflow: clip;
  }

  .ab-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 60% at 90% 20%, rgb(199 116 21 / 0.1), transparent 70%),
      radial-gradient(50% 60% at 5% 85%, rgb(62 78 245 / 0.08), transparent 70%);
    pointer-events: none;
  }

  .ab-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .ab-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .ab-hero h1 {
    max-width: 16ch;
  }

  .ab-hero-art {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    box-shadow: var(--shadow-lift);
    aspect-ratio: 4 / 3.2;
    background: var(--color-paper-2);
  }

  .ab-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ab-hero-art figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
  }

  .ab-split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .ab-sticky {
    position: sticky;
    top: 7rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .ab-note {
    font-size: 0.95rem;
    color: var(--color-ink-2);
    line-height: 1.65;
    max-width: 30rem;
  }

  .principles {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .principles li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
  }

  .principles li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
  }

  .pr-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--color-amber);
    padding-top: 0.35rem;
  }

  .principles h3 {
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.38rem);
    font-weight: 590;
    margin-bottom: 0.5rem;
  }

  .principles p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-ink-2);
    max-width: 36rem;
  }

  /* don'ts */
  .dont-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .dont-grid > div {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .dont-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .dont-list li {
    position: relative;
    padding: 1rem 1.2rem 1rem 3rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 14px;
    font-size: 0.95rem;
    color: var(--color-ink-2);
    line-height: 1.55;
    transition: transform 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
  }

  .dont-list li:hover {
    transform: translateX(6px);
    border-color: color-mix(in srgb, var(--color-coral) 40%, transparent);
  }

  .dont-list li::before {
    content: '';
    position: absolute;
    left: 1.15rem;
    top: 50%;
    width: 0.85rem;
    height: 2.5px;
    background: var(--color-coral);
    border-radius: 2px;
    transform: translateY(-50%);
  }

  /* process */
  .ab-process {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .ab-step {
    padding: 1.6rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 18px;
    background: linear-gradient(180deg, #fff, var(--color-paper));
    position: relative;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .ab-step:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lift);
  }

  .ab-step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.4rem;
    right: 1.4rem;
    height: 3px;
    background: linear-gradient(90deg, var(--color-indigo), color-mix(in srgb, var(--color-amber) 80%, var(--color-indigo)));
    border-radius: 0 0 4px 4px;
  }

  .step-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .ab-step h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 400;
    margin: 0.6rem 0 0.55rem;
  }

  .ab-step p {
    font-size: 0.89rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .ab-who {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .ab-who > div {
    background: color-mix(in srgb, var(--color-indigo) 4%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-indigo) 16%, transparent);
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
  }

  .ab-who > div:last-child {
    background: color-mix(in srgb, var(--color-amber) 5%, #fff);
    border-color: color-mix(in srgb, var(--color-amber) 22%, transparent);
  }

  .ab-who .label-mono {
    margin-bottom: 0.6rem;
  }

  .ab-who p:not(.label-mono) {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  @media (max-width: 64rem) {
    .ab-hero-grid,
    .ab-split,
    .dont-grid {
      grid-template-columns: 1fr;
    }

    .ab-sticky {
      position: static;
    }

    .ab-process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ab-who {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 42rem) {
    .ab-process {
      grid-template-columns: 1fr;
    }
  }
</style>
