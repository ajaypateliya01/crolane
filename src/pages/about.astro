---
export const prerender = true;

import Base from '../layouts/Base.astro';
import NightHero from '../components/ui/NightHero.astro';
import Founder from '../components/ui/Founder.astro';
import Faq from '../components/ui/Faq.astro';
import CtaNight from '../components/ui/CtaNight.astro';
import { UA } from '../components/ui/Icons';
import { SITE } from '../config/site';
import site from '../content/settings/site.json';

const title = 'About Ajay Pateliya and CROLANE | Developer-Led CRO';
const description = 'CROLANE is run by Ajay Pateliya, a developer who builds A/B tests, GA4 tracking and AI automation for ecommerce brands. How the work is done, and what is never promised.';

const principles = [
  ['The question comes first', 'Every engagement starts with the business decision in front of you. Tools, tests and automations only matter in service of that decision.'],
  ['Data has to earn trust', 'Before conclusions, collection. Events are validated, gaps are flagged and anything estimated is labelled as such.'],
  ['Small bets over big rebuilds', 'Where evidence supports it, targeted changes beat full redesigns. When a bigger change is needed, the evidence should make that obvious.'],
  ['AI with a supervisor', 'Models read, draft, classify and answer within boundaries. People keep the commitments and the edge cases.'],
];
const donts = [
  'Guaranteed conversion lifts or fixed win rates',
  'Invented case studies, logos, testimonials or awards',
  'Vague scopes that hide what the work includes',
  'Locking your data or accounts behind our tools',
  'Automation that acts on customers unsupervised from day one',
];
const faqs = [
  { q: 'Who will actually do the work?', a: `${site.founder.name}. You work with the same person from the first message to the last fix. There is no hand-off to a junior team.` },
  { q: 'Where are you based and what hours do you work?', a: 'CROLANE works remotely with brands in the US, UK, Australia and Canada, and replies to every message within 24 hours.' },
  { q: 'Can I see past client work?', a: 'Client work is under NDA, so it is not published. The demos on this site show how the work functions, and a free audit of your own store is the best way to judge the quality.' },
];
const ld = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  url: `${SITE.url}/about/`,
  mainEntity: { '@type': 'Person', name: site.founder.name, jobTitle: site.founder.role, sameAs: [site.founder.linkedin], worksFor: { '@id': `${SITE.url}/#organization` } },
}];
---
<Base title={title} description={description} jsonLd={ld}>
  <NightHero>
    <div>
      <p class="kicker" style="margin-bottom:18px">About</p>
      <h1 class="h1 sm">Senior CRO work, without the <span class="it">agency layers</span></h1>
      <p class="lede" style="margin-top:22px">{site.founder.bio}</p>
      <div class="actions">
        <a class="btn btn-white" href="/contact/">Talk to Ajay <Fragment set:html={UA} /></a>
        <a class="btn btn-line" href={site.founder.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
    <div class="about-face"><Founder size="xl" /><p><b>{site.founder.name}</b><br />{site.founder.role}</p></div>
  </NightHero>

  <section>
    <div class="wrap">
      <div class="sec-title"><p class="kicker c rv">How the work is done</p><h2 class="h2 rv" style="margin-top:14px">Four principles, <span class="it">no exceptions</span></h2></div>
      <div class="get-grid">{principles.map((p, i) => <div class="get rv"><span class="gi">0{i + 1}</span><h3 class="h3">{p[0]}</h3><p>{p[1]}</p></div>)}</div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap steps-grid" style="align-items:start">
      <div>
        <p class="kicker rv">What you will never get</p>
        <h2 class="h2 rv" style="margin-top:14px">Honest limits, <span class="it">in writing</span></h2>
        <p class="rv" style="margin-top:18px;color:var(--ink-2);max-width:30rem">CRO has a trust problem. These are the things CROLANE will not do, whatever the deal size.</p>
      </div>
      <ul class="fix-list" style="grid-template-columns:1fr">{donts.map((d) => <li class="rv">{d}</li>)}</ul>
    </div>
  </section>

  <Faq items={faqs} title="About CROLANE" />
  <CtaNight />
</Base>

<style>
  .about-face { display: grid; justify-items: center; gap: 18px; text-align: center; color: #cfc8e6; }
  .about-face b { color: #fff; font-family: var(--serif); font-size: 1.6rem; font-weight: 400; }
</style>
