---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import NightHero from '../../components/ui/NightHero.astro';
import Demo from '../../components/ui/Demo.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import CtaNight from '../../components/ui/CtaNight.astro';
import { UA } from '../../components/ui/Icons';
import { SERVICES, GROUPS } from '../../config/services';
import { SITE } from '../../config/site';

const title = 'CRO, Analytics and AI Automation Services | CROLANE';
const description = 'All CROLANE services: CRO audits, A/B testing, Shopify audits, GA4 and conversion tracking, AI voice receptionists, n8n workflows and AI agent audits.';
const ld = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE.url}${s.path}` })),
}];
---
<Base title={title} description={description} jsonLd={ld}>
  <NightHero>
    <div>
      <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Services</span></nav>
      <p class="kicker" style="margin-bottom:18px">CRO, analytics and AI services</p>
      <h1 class="h1 sm">Services that turn traffic into <span class="it">revenue</span></h1>
      <p class="lede" style="margin-top:22px">Conversion optimization, analytics and AI automation. Use one service or combine them into a growth program.</p>
      <div class="actions">
        <a class="btn btn-white" href="#mini-audit">Get a free audit <Fragment set:html={UA} /></a>
        <a class="btn btn-line" href="/pricing/">See pricing</a>
      </div>
    </div>
    <Demo kind="dash" dark />
  </NightHero>
  <section>
    <div class="wrap">
      {GROUPS.map((g) => (
        <>
          <div class="grp-h rv"><h2 class="h2" style="font-size:clamp(1.9rem,3vw,2.6rem)">{g}</h2></div>
          <div class="grid3">{SERVICES.filter((s) => s.grp === g).map((s) => <div class="rv"><ServiceCard s={s} /></div>)}</div>
        </>
      ))}
    </div>
  </section>
  <CtaNight />
</Base>
