# ---------------------------------------------------------------------------
# CROLANE environment variables
# Copy this file to `.env` for local development, and set the same values in
# hPanel -> Website -> [your app] -> Environment variables on Hostinger.
# Never commit the real `.env` file to Git.
# ---------------------------------------------------------------------------

# Public site origin (no trailing slash). Used for canonical URLs, the
# sitemap and Open Graph tags at build time.
SITE_URL=https://crolane.in

# Outbound email (SMTP) settings used by /api/contact to deliver inquiries
# to admin@crolane.in. On Hostinger, create a mailbox in hPanel -> Emails and
# use its SMTP credentials (host/ports are shown in the mailbox settings).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Who the message is sent from and to.
# MAIL_FROM must match the authenticated mailbox or an authorised sender.
MAIL_FROM="CROLANE Website <no-reply@crolane.in>"
MAIL_FROM_NAME=CROLANE Website
MAIL_TO=admin@crolane.in

# Optional: comma separated list of allowed browser origins for the contact
# API. When empty, same-origin requests are accepted without an origin check.
ALLOWED_ORIGINS=

# Optional: comma separated IP addresses or CIDR ranges that skip the
# built-in rate limiter (useful for health checks). Never wildcard everything.
RATE_LIMIT_SKIP=

# Set to "true" to log contact submissions to the server console instead of
# sending email. Local development convenience only; leave unset in production.
MAIL_DEV_LOG=false
